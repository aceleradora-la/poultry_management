<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formato apaisado (landscape) para el parte de producción -->
    <record id="paperformat_poultry_egg_collection_landscape" model="report.paperformat">
        <field name="name">A4 Apaisado - Parte Producción</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">23</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
    </record>

    <record id="action_report_poultry_egg_collection_daily" model="ir.actions.report">
        <field name="name">Parte diario de Producción</field>
        <field name="model">poultry.egg.collection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">poultry_management.report_poultry_egg_collection_daily</field>
        <field name="report_file">poultry_management.report_poultry_egg_collection_daily</field>
        <field name="print_report_name">'Parte_Produccion_%s' % (object.name.replace('/', '-'))</field>
        <field name="paperformat_id" ref="paperformat_poultry_egg_collection_landscape"/>
        <!-- Sin binding_model_id: no aparece en el menú Imprimir estándar, solo en nuestro botón -->
    </record>
</odoo>
