<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Planilla de pesaje para anotar a mano. Encabezado propio con el logo y los datos de
         la empresa cargados en Odoo (no usa web.external_layout: el diseño elegido en
         Ajustes, como "Wave", encima su dirección sobre el contenido y dibuja cajas en las
         tablas). Cuerpo sin recuadros: tres secciones que se llenan de arriba abajo, cada
         jaula con su título y una línea por ave, en el orden físico de las jaulas. -->
    <record id="paperformat_weight_sheet" model="report.paperformat">
        <field name="name">Planilla de Pesaje A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_spacing">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <template id="report_weight_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="company" t-value="o.env.company"/>
                <!-- Un article por parte: así Odoo envuelve cada uno con su cabecera HTML
                     (DOCTYPE y charset utf-8). Sin article, wkhtmltopdf lee los acentos en
                     Latin-1. El style va adentro porque lo de afuera se descarta. -->
                <div class="article pw" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <style>
                        body { max-width: none !important; margin: 0 !important; padding: 0 !important; }
                        .pw { color: #1f2937; font-size: 9pt; font-family: Arial, Helvetica, sans-serif; }
                        .pw table, .pw tr, .pw td, .pw th { border: 0 !important; padding: 0; background: none !important; box-shadow: none !important; vertical-align: top; }
                        .pw table { width: 100%; table-layout: fixed; border-collapse: collapse; }
                        .pw-break { page-break-before: always; }
                        .pw-company { border-bottom: 1px solid #1f2937; padding-bottom: 2mm; }
                        .pw-company td.pw-logo { width: 60mm; vertical-align: middle; }
                        .pw-company img { max-height: 14mm; max-width: 55mm; }
                        .pw-company td.pw-details { text-align: right; font-size: 7.5pt; color: #4b5563; line-height: 1.35; vertical-align: middle; }
                        .pw-company .pw-company-name { font-size: 9.5pt; font-weight: bold; color: #1f2937; }
                        .pw-head { margin-top: 4mm; }
                        .pw-title { font-size: 15pt; font-weight: bold; line-height: 1.15; }
                        .pw-sub { font-size: 7.5pt; color: #6b7280; margin-top: 1mm; }
                        .pw-number { text-align: right; }
                        .pw-label { font-size: 6.5pt; color: #6b7280; text-transform: uppercase; letter-spacing: 0.5pt; }
                        .pw-value { font-size: 10.5pt; font-weight: bold; }
                        .pw-name { font-size: 17pt; font-weight: bold; line-height: 1.1; }
                        .pw-fields { margin-top: 3mm; border-top: 1px solid #d1d5db !important; border-bottom: 1px solid #d1d5db !important; }
                        .pw-fields td { padding: 1.8mm 2mm 1.8mm 0 !important; }
                        .pw table.pw-cols { margin-top: 4mm; }
                        .pw table.pw-cols td { width: 33.33%; padding-right: 6mm !important; }
                        .pw table.pw-cols td.pw-last { padding-right: 0 !important; }
                        .pw-group { margin-bottom: 3.2mm; }
                        .pw-cage { font-size: 10pt; font-weight: bold; border-bottom: 1.5pt solid #1f2937; padding-bottom: 0.8mm; }
                        .pw-cont { float: right; font-weight: normal; font-style: italic; font-size: 7pt; color: #6b7280; padding-top: 1mm; }
                        .pw-row { height: 5mm; line-height: 5mm; border-bottom: 1px solid #c8ccd2; font-size: 8pt; color: #6b7280; }
                        .pw-row .pw-n { display: inline-block; width: 7mm; }
                        .pw-row .pw-g { float: right; font-size: 6.5pt; color: #c8ccd2; }
                        .pw-foot { margin-top: 4mm; }
                        .pw-foot td { padding-right: 8mm !important; }
                        .pw-line { height: 6mm; border-bottom: 1px solid #c8ccd2; }
                        .pw-sign { height: 8mm; border-bottom: 1px solid #1f2937; }
                        .pw-note { margin-top: 2mm; font-size: 7pt; color: #6b7280; }
                        .pw-note .pw-page { float: right; }
                    </style>
                    <t t-set="pages" t-value="o._poultry_sheet_pages(rows_per_column=38) or [[]]"/>
                    <t t-foreach="pages" t-as="page">
                        <div t-attf-class="{{'' if page_first else 'pw-break'}}">
                            <table class="pw-company">
                                <tr>
                                    <td class="pw-logo">
                                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                                        <div t-else="" class="pw-company-name" t-out="company.name"/>
                                    </td>
                                    <td class="pw-details">
                                        <div t-if="company.logo" class="pw-company-name" t-out="company.name"/>
                                        <div t-out="' · '.join(part.strip() for part in company.partner_id._display_address(without_company=True).split('\n') if part.strip())"/>
                                        <div t-if="company.vat"><t t-out="company.country_id.vat_label or 'CUIT'"/>: <t t-out="company.vat"/></div>
                                    </td>
                                </tr>
                            </table>
                            <table class="pw-head">
                                <tr>
                                    <td style="width: 65%">
                                        <div class="pw-title">Planilla de Pesaje de Aves</div>
                                        <div class="pw-sub">Registro manual · una fila por ave · peso en gramos</div>
                                    </td>
                                    <td class="pw-number">
                                        <div class="pw-label">Parte N°</div>
                                        <div class="pw-name" t-out="o.name"/>
                                    </td>
                                </tr>
                            </table>
                            <table class="pw-fields">
                                <tr>
                                    <td><div class="pw-label">Galpón</div><div class="pw-value" t-out="o.coop_id.name"/></td>
                                    <td><div class="pw-label">Lote de aves</div><div class="pw-value" t-out="o.batch_id.name"/></td>
                                    <td><div class="pw-label">Fecha</div><div class="pw-value" t-field="o.date"/></td>
                                </tr>
                                <tr>
                                    <td><div class="pw-label">Semana de vida</div><div class="pw-value" t-out="o.batch_age_weeks"/></td>
                                    <td><div class="pw-label">Responsable</div><div class="pw-value" t-out="o.operator_id.name or '________________________'"/></td>
                                    <td><div class="pw-label">Previsto</div><div class="pw-value"><t t-out="o.cage_count"/> jaulas · <t t-out="o.planned_bird_count"/> aves</div></td>
                                </tr>
                            </table>
                            <table class="pw-cols">
                                <tr>
                                    <t t-foreach="range(3)" t-as="col_index">
                                        <td t-attf-class="{{'pw-last' if col_index == 2 else ''}}">
                                            <t t-if="col_index &lt; len(page)">
                                                <t t-foreach="page[col_index]" t-as="group">
                                                    <div class="pw-group">
                                                        <div class="pw-cage">
                                                            Jaula <t t-out="group['cage'].code"/>
                                                            <span t-if="group['continued']" class="pw-cont">continúa</span>
                                                        </div>
                                                        <div t-foreach="group['rows']" t-as="line" class="pw-row">
                                                            <span class="pw-n" t-out="line.bird_no"/>
                                                            <span class="pw-g">g</span>
                                                        </div>
                                                    </div>
                                                </t>
                                            </t>
                                        </td>
                                    </t>
                                </tr>
                            </table>
                            <table class="pw-foot">
                                <tr>
                                    <td style="width: 70%">
                                        <div class="pw-label">Observaciones</div>
                                        <div class="pw-line"/>
                                        <div class="pw-line"/>
                                    </td>
                                    <td>
                                        <div class="pw-sign"/>
                                        <div class="pw-label" style="margin-top: 1mm">Firma del responsable</div>
                                    </td>
                                </tr>
                            </table>
                            <div class="pw-note">
                                <span class="pw-page">Hoja <t t-out="page_index + 1"/> de <t t-out="len(pages)"/></span>
                                Las jaulas siguen el orden físico: fila, lado, claro, piso, jaula. Las filas sin peso quedan vacías.
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_weight_sheet" model="ir.actions.report">
        <field name="name">Planilla de Pesaje</field>
        <field name="model">poultry.weight.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">poultry_management.report_weight_sheet</field>
        <field name="report_file">poultry_management.report_weight_sheet</field>
        <field name="print_report_name">'Planilla %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_weight_sheet"/>
        <field name="binding_model_id" ref="model_poultry_weight_record"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
