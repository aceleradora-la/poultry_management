<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vistas de Wizard -->
    <record id="view_poultry_mortality_report_wizard_form" model="ir.ui.view">
        <field name="name">poultry.mortality.report.wizard.form</field>
        <field name="model">poultry.mortality.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Mortalidad">
                <sheet>
                    <group>
                        <group>
                            <field name="coop_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="genetics_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="indicator_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="compare_with_standards"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Generar Reporte" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_poultry_comparison_report_wizard_form" model="ir.ui.view">
        <field name="name">poultry.comparison.report.wizard.form</field>
        <field name="model">poultry.comparison.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte Comparativo">
                <sheet>
                    <group>
                        <group>
                            <field name="genetics_id" required="1" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="coop_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="report_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Generar Reporte" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

