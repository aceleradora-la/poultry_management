<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reportes de Mortalidad -->
    <record id="action_poultry_mortality_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Mortalidad</field>
        <field name="res_model">poultry.mortality.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Reportes Comparativos -->
    <record id="action_poultry_comparison_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte Comparativo (Real vs Estándar)</field>
        <field name="res_model">poultry.comparison.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <!-- Acción directa para Reporte de Producción con Pivot (basado en líneas) -->
    <record id="action_poultry_production_report_direct" model="ir.actions.act_window">
        <field name="name">Reporte de Producción</field>
        <field name="res_model">poultry.egg.collection.line</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('collection_id.state', '=', 'done')]</field>
        <field name="context">{
            'pivot_measures': ['total_produced_reference', 'total_boxes', 'average_weight_elaborated_aggregated'],
            'pivot_row_groupby': ['collection_date:day'],
            'pivot_column_groupby': ['collection_coop_id'],
            'graph_measure': 'total_produced_reference',
            'graph_groupbys': ['collection_date:month', 'collection_coop_id'],
        }</field>
    </record>

    <!-- Acción: Movimientos de Productos Avícolas -->
    <record id="action_poultry_stock_move_report" model="ir.actions.act_window">
        <field name="name">Movimientos de Productos</field>
        <field name="res_model">stock.move</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="view_id" ref="view_poultry_stock_move_tree"/>
        <field name="search_view_id" ref="view_poultry_stock_move_search"/>
        <field name="domain">[('product_id.product_tmpl_id.is_egg_production', '=', True)]</field>
        <field name="context">{'search_default_filter_poultry_products': 1, 'search_default_filter_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Movimientos de inventario de productos Avícolas
            </p>
            <p>
                Este reporte muestra todos los movimientos de inventario de productos
                marcados como "Usar en Producción de Huevos". Las columnas Huevos y Cajones
                muestran las cantidades convertidas usando la misma lógica del Reporte de Producción.
            </p>
        </field>
    </record>

    <!-- Menús de Reportes (el menú padre "Reportes" está definido en poultry_menus.xml) -->
    <menuitem id="menu_poultry_production_report" 
              name="Producción" 
              parent="menu_poultry_reports" 
              action="action_poultry_production_report_direct" 
              sequence="10"/>

    <menuitem id="menu_poultry_stock_move_report" 
              name="Movimientos de Productos" 
              parent="menu_poultry_reports" 
              action="action_poultry_stock_move_report" 
              sequence="15"/>

    <menuitem id="menu_poultry_mortality_report" 
              name="Mortalidad" 
              parent="menu_poultry_reports" 
              action="action_poultry_mortality_report_wizard" 
              sequence="20"/>

    <menuitem id="menu_poultry_comparison_report" 
              name="Comparativo (Real vs Estándar)" 
              parent="menu_poultry_reports" 
              action="action_poultry_comparison_report_wizard" 
              sequence="30"/>
</odoo>

