<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reutiliza el formato apaisado ya definido para el parte de producción,
         apropiado para una tabla ancha con varios indicadores en columnas. -->
    <record id="action_report_poultry_standard_tracking" model="ir.actions.report">
        <field name="name">Seguimiento de Estándares</field>
        <field name="model">poultry.standard.tracking.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">poultry_management.report_poultry_standard_tracking</field>
        <field name="report_file">poultry_management.report_poultry_standard_tracking</field>
        <field name="print_report_name">'Seguimiento de Estándares - %s' % (object.batch_id.name)</field>
        <field name="paperformat_id" ref="paperformat_poultry_egg_collection_landscape"/>
        <!-- Sin binding_model_id: no aparece en el menú Imprimir estándar, solo desde el wizard -->
    </record>
</odoo>
