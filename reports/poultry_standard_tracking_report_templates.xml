<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_poultry_standard_tracking">
        <t t-foreach="docs" t-as="doc">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-3" style="padding: 10px; font-size: 1.05rem;">
                            <div class="col-4 text-left">
                                <span style="font-weight: bold; text-decoration: underline;">Seguimiento de Estándares</span>
                            </div>
                            <div class="col-4 text-left">
                                <strong>Lote:</strong>
                                <span t-field="doc.batch_id.name"/>
                            </div>
                            <div class="col-4 text-left">
                                <strong>Genética:</strong>
                                <span t-field="doc.genetics_id.name"/>
                            </div>
                        </div>
                        <div class="row mb-3 text-left" style="padding: 10px;">
                            <div class="col-4">
                                <strong>Versión de Estándar:</strong>
                                <span t-esc="(doc.version_id or doc.genetics_id.default_standard_version_id).name"/>
                            </div>
                            <div class="col-4">
                                <strong>Galpón:</strong>
                                <span t-esc="doc.current_coop_names or '-'"/>
                            </div>
                            <div class="col-4">
                                <strong>Fecha de Ingreso a Galpón:</strong>
                                <span t-esc="doc.current_coop_date_from or '-'"/>
                            </div>
                        </div>
                        <div class="row mb-3 text-left" style="padding: 10px;">
                            <div class="col-4">
                                <!-- Aves Alojadas (foto a la Entrada en Producción, igual que
                                     la ficha del lote); en crianza, la Cantidad de Aves. -->
                                <strong>Aves Alojadas:</strong>
                                <span t-esc="doc.batch_id.housed_bird_count or doc.batch_id.bird_count"/>
                            </div>
                        </div>

                        <t t-set="report_data" t-value="doc.get_report_data()"/>
                        <t t-set="axis" t-value="report_data['header'].get('axis')"/>
                        <t t-foreach="[('crianza', 'Crianza'), ('produccion', 'Producción')]" t-as="period_entry">
                            <t t-set="period_key" t-value="period_entry[0]"/>
                            <t t-set="period_label" t-value="period_entry[1]"/>
                            <t t-set="period_data" t-value="report_data[period_key]"/>
                            <t t-if="period_data['rows']">
                                <h4 style="margin-top: 20px;"><t t-esc="period_label"/></h4>
                                <table class="table table-bordered table-sm" style="font-size: 0.75rem;">
                                    <thead>
                                        <tr>
                                            <th rowspan="2" style="vertical-align: middle; text-align: center; background: none !important; color: #333 !important;">
                                                <t t-if="axis == 'calendar_week'">Lote</t>
                                                <t t-else="">Edad</t>
                                            </th>
                                            <th rowspan="2" style="vertical-align: middle; text-align: center; background: none !important; color: #333 !important;">
                                                <t t-if="axis == 'calendar_week'">Semana (cierra)</t>
                                                <t t-else="">Fecha</t>
                                            </th>
                                            <th rowspan="2" style="vertical-align: middle; text-align: center; background: none !important; color: #333 !important;">
                                                Aves Vivas
                                            </th>
                                            <t t-foreach="period_data['indicators']" t-as="indicator">
                                                <th colspan="3" style="text-align: center; background: none !important; color: #333 !important; border-bottom: 1px solid #333;">
                                                    <t t-esc="indicator['name']"/>
                                                </th>
                                            </t>
                                        </tr>
                                        <tr>
                                            <t t-foreach="period_data['indicators']" t-as="indicator">
                                                <th style="text-align: center; background: none !important; color: #333 !important; font-weight: normal;">Bajo</th>
                                                <th style="text-align: center; background: none !important; color: #333 !important; font-weight: normal;">Alto</th>
                                                <th style="text-align: center; background: none !important; color: #333 !important; font-weight: bold;">Real</th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="period_data['rows']" t-as="row">
                                            <td style="text-align: center; font-weight: bold; white-space: nowrap;">
                                                <t t-if="axis != 'calendar_week'" t-esc="row['week']"/>
                                            </td>
                                            <td style="text-align: center; white-space: nowrap;">
                                                <t t-esc="row['date']"/>
                                            </td>
                                            <td style="text-align: center; white-space: nowrap;">
                                                <t t-if="row.get('live_birds') is not None" t-esc="row['live_birds']"/>
                                            </td>
                                            <t t-foreach="period_data['indicators']" t-as="indicator">
                                                <t t-set="cell" t-value="row['cells'][indicator['id']]"/>
                                                <td style="text-align: center;">
                                                    <t t-if="cell['has_standard']" t-esc="'%.2f' % cell['value_low']"/>
                                                </td>
                                                <td style="text-align: center;">
                                                    <t t-if="cell['has_standard']" t-esc="'%.2f' % cell['value_high']"/>
                                                </td>
                                                <td t-attf-style="text-align: center;#{' color: %s;' % cell['real_color'] if cell.get('real_color') else ''}#{' font-weight: bold;' if cell['out_of_range'] else ''}">
                                                    <!-- Decimales por indicador: 0 para cantidades (aves muertas), 2 para el resto. -->
                                                    <t t-if="cell['real_value'] is not None"
                                                       t-esc="('%.{}f'.format(indicator.get('decimals', 2))) % cell['real_value']"/>
                                                </td>
                                            </t>
                                        </tr>
                                        <!-- Detalle por lote: en pantalla se despliega, pero el
                                             PDF no tiene interacción y en el eje calendario el
                                             detalle ES el reporte (cada lote con su Semana de
                                             Vida y su estándar), así que va impreso siempre. -->
                                        <t t-if="axis == 'calendar_week'">
                                            <tr t-foreach="row.get('batch_rows') or []" t-as="batch_row"
                                                style="background-color: #f8f9fa;">
                                                <td style="text-align: center; white-space: nowrap;">
                                                    <t t-esc="batch_row['name']"/>
                                                </td>
                                                <td style="text-align: center; white-space: nowrap;">
                                                    <t t-if="batch_row.get('life_week')">Sem. <t t-esc="batch_row['life_week']"/></t>
                                                </td>
                                                <td style="text-align: center; white-space: nowrap;">
                                                    <t t-if="batch_row.get('live_birds') is not None" t-esc="batch_row['live_birds']"/>
                                                </td>
                                                <t t-foreach="period_data['indicators']" t-as="indicator">
                                                    <t t-set="bv" t-value="batch_row['values'].get(indicator['id'])"/>
                                                    <td style="text-align: center;">
                                                        <t t-if="bv and bv.get('has_standard')" t-esc="'%.2f' % bv['value_low']"/>
                                                    </td>
                                                    <td style="text-align: center;">
                                                        <t t-if="bv and bv.get('has_standard')" t-esc="'%.2f' % bv['value_high']"/>
                                                    </td>
                                                    <td t-attf-style="text-align: center;#{' color: %s;' % bv['real_color'] if bv and bv.get('real_color') else ''}">
                                                        <t t-if="bv"
                                                           t-esc="('%.{}f'.format(indicator.get('decimals', 2))) % bv['real_value']"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
