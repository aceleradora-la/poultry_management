<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El reporte en pantalla ya permite elegir Lote y Versión de Estándar desde sus
         propios selectores, así que el menú abre directamente el componente para el
         primer lote activo en vez de pasar por un formulario de selección previo. -->
    <record id="action_poultry_standard_tracking_report_open" model="ir.actions.server">
        <field name="name">Seguimiento de Estándares</field>
        <field name="model_id" ref="model_poultry_standard_tracking_report_wizard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_direct()</field>
    </record>

    <menuitem id="menu_poultry_standard_tracking_report"
              name="Seguimiento de Estándares"
              parent="menu_poultry_reports"
              action="action_poultry_standard_tracking_report_open"
              sequence="25"/>
</odoo>
