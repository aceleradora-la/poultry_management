<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario de selección previa: al abrir el reporte desde el menú se elige
         Lote (y opcionalmente Lotes a Comparar y Versión de Estándar) antes de ver
         la pantalla. Adentro del reporte los selectores siguen permitiendo cambiar
         lotes y versión sin volver a este formulario. -->
    <record id="view_poultry_standard_tracking_report_wizard_form" model="ir.ui.view">
        <field name="name">poultry.standard.tracking.report.wizard.form</field>
        <field name="model">poultry.standard.tracking.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Seguimiento de Estándares">
                <group>
                    <field name="report_period" invisible="1"/>
                    <field name="genetics_id" invisible="1"/>
                    <field name="batch_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="comparison_batch_ids" widget="many2many_tags"
                           domain="[('genetics_id', '=', genetics_id), ('id', '!=', batch_id), ('active', '=', True)]"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="version_id" options="{'no_create': True, 'no_create_edit': True}"
                           placeholder="Versión predeterminada de la genética"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Ver Reporte" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_poultry_standard_tracking_wizard_crianza" model="ir.actions.act_window">
        <field name="name">Seguimiento Estándares - Crianza</field>
        <field name="res_model">poultry.standard.tracking.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_poultry_standard_tracking_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_report_period': 'crianza'}</field>
    </record>

    <record id="action_poultry_standard_tracking_wizard_produccion" model="ir.actions.act_window">
        <field name="name">Seguimiento Estándares - Producción</field>
        <field name="res_model">poultry.standard.tracking.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_poultry_standard_tracking_report_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_report_period': 'produccion'}</field>
    </record>

    <menuitem id="menu_poultry_standard_tracking_report"
              name="Seguimiento Estándares - Crianza"
              parent="menu_poultry_reports"
              action="action_poultry_standard_tracking_wizard_crianza"
              sequence="25"/>

    <menuitem id="menu_poultry_standard_tracking_report_produccion"
              name="Seguimiento Estándares - Producción"
              parent="menu_poultry_reports"
              action="action_poultry_standard_tracking_wizard_produccion"
              sequence="26"/>
</odoo>
