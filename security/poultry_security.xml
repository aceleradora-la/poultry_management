<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: la ficha del usuario dibuja cada res.groups.privilege como UN desplegable
         de un solo valor y, al guardar, conserva un grupo por privilegio. Los permisos que
         se combinan entre sí necesitan cada uno su propio privilegio; compartir el de
         Manufactura borra grupos sin avisar. -->
    <record id="module_category_poultry" model="ir.module.category">
        <field name="name">Gestión Avícola</field>
        <field name="sequence">26</field>
    </record>

    <record id="res_groups_privilege_poultry_role" model="res.groups.privilege">
        <field name="name">Rol</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_poultry"/>
    </record>

    <record id="res_groups_privilege_poultry_collection" model="res.groups.privilege">
        <field name="name">Partes de Producción</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_poultry"/>
    </record>

    <record id="res_groups_privilege_poultry_coop_close" model="res.groups.privilege">
        <field name="name">Cierres de Galpón</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_poultry"/>
    </record>

    <record id="res_groups_privilege_poultry_mortality" model="res.groups.privilege">
        <field name="name">Mortandad</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_poultry"/>
    </record>

    <!-- App Avícola Campo: lo que se carga desde el celular en el galpón (hoy el pesaje).
         Es un privilegio propio para dárselo al operador sin abrirle Gestión Avícola. -->
    <record id="res_groups_privilege_poultry_field" model="res.groups.privilege">
        <field name="name">App Avícola Campo</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="module_category_poultry"/>
    </record>

    <record id="poultry_user" model="res.groups">
        <field name="name">Usuario Avícola</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_poultry_role"/>
    </record>

    <record id="poultry_field_user" model="res.groups">
        <field name="name">Operador de Campo</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_poultry_field"/>
        <field name="comment">Usa la app Avícola Campo desde el celular: pesa las aves de las
            pesadas que la oficina envió a pesar y las registra. No ve Gestión Avícola.</field>
    </record>

    <!-- El Gestor también usa la app del celular; el Usuario Avícola (oficina) la recibe
         solo si se le da el permiso. -->
    <record id="poultry_manager" model="res.groups">
        <field name="name">Gestor Avícola</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_poultry_role"/>
        <field name="implied_ids" eval="[(4, ref('poultry_user')), (4, ref('poultry_field_user'))]"/>
    </record>

    <record id="poultry_cancel_processed_collection" model="res.groups">
        <field name="name">Cancelar Partes Procesados</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_poultry_collection"/>
    </record>

    <record id="poultry_delete_coop_close" model="res.groups">
        <field name="name">Eliminar Cierres de Galpón</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_poultry_coop_close"/>
        <field name="comment">Permite eliminar cierres de galpón en estado Borrador.</field>
    </record>

    <!-- Permiso especial: carga manual de mortandad (día por día y por lote) desde el
         Reporte de Mortandad, para registrar aves muertas de fechas anteriores. -->
    <record id="group_poultry_mortality_manual" model="res.groups">
        <field name="name">Mortandad: Carga Manual</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_poultry_mortality"/>
        <field name="implied_ids" eval="[(4, ref('poultry_user'))]"/>
        <field name="comment">Permite crear y editar manualmente registros de mortandad
            (día por día y por lote) desde el Reporte de Mortandad, y corregir las Aves
            Muertas y la Fecha de Recolección/Postura de OFs de cierre ya procesadas
            (con resincronización y recálculo automáticos). La carga automática desde
            la Orden de Fabricación no requiere este permiso.</field>
    </record>

    <!-- Los usuarios/gestores sin el permiso especial solo pueden operar sobre los
         registros generados por la OF (production_id definido); no pueden crear ni
         editar registros manuales (production_id vacío). No restringe la lectura. -->
    <record id="rule_poultry_mortality_auto_only" model="ir.rule">
        <field name="name">Mortandad: solo registros generados por OF</field>
        <field name="model_id" ref="model_poultry_mortality"/>
        <field name="groups" eval="[(4, ref('poultry_user')), (4, ref('poultry_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[('production_id', '!=', False)]</field>
    </record>

    <!-- El grupo de carga manual puede crear/editar/eliminar cualquier registro
         (incluidos los manuales, production_id vacío). -->
    <record id="rule_poultry_mortality_manual_all" model="ir.rule">
        <field name="name">Mortandad: carga manual (todos los registros)</field>
        <field name="model_id" ref="model_poultry_mortality"/>
        <field name="groups" eval="[(4, ref('group_poultry_mortality_manual'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
