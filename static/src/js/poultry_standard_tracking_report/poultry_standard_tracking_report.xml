<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="poultry_management.PoultryStandardTrackingReport" owl="1">
        <div class="o_action o_poultry_standard_tracking_report">
            <div class="o_control_panel">
                <div class="o_control_panel_main d-flex align-items-center flex-wrap gap-2 p-2">
                    <h5 class="mb-0 me-3"><t t-esc="title"/></h5>
                    <div class="d-flex align-items-center flex-wrap gap-1 me-2 border rounded px-2 py-1"
                         t-if="header" style="min-height: 31px;">
                        <t t-foreach="selectedBatches" t-as="b" t-key="b.id">
                            <span class="badge rounded-pill text-bg-light border">
                                <t t-esc="b.name"/>
                                <a href="#" class="ms-1 text-decoration-none text-secondary"
                                   t-if="selectedBatches.length > 1"
                                   t-on-click.prevent="() => this.onRemoveBatch(b.id)">×</a>
                            </span>
                        </t>
                        <select class="form-select form-select-sm w-auto border-0 py-0"
                                t-if="addableBatches.length" t-on-change="onAddBatch">
                            <option value="">+ Lote</option>
                            <t t-foreach="addableBatches" t-as="batch" t-key="batch.id">
                                <option t-att-value="batch.id"><t t-esc="batch.name"/></option>
                            </t>
                        </select>
                    </div>
                    <select class="form-select form-select-sm w-auto me-2" t-on-change="onVersionChange" t-if="header">
                        <t t-foreach="header.version_options" t-as="v" t-key="v.id">
                            <option t-att-value="v.id"
                                    t-att-selected="header.version_id === v.id">
                                <t t-esc="v.name"/>
                            </option>
                        </t>
                    </select>
                    <div class="btn-group me-2" role="group" t-if="!fixedPeriod">
                        <button class="btn btn-sm"
                                t-att-class="state.period === 'crianza' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setPeriod('crianza')">
                            Crianza
                        </button>
                        <button class="btn btn-sm"
                                t-att-class="state.period === 'produccion' ? 'btn-primary' : 'btn-outline-primary'"
                                t-on-click="() => this.setPeriod('produccion')">
                            Producción
                        </button>
                    </div>
                    <div class="dropdown me-2" t-if="currentData">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            Indicadores
                        </button>
                        <ul class="dropdown-menu p-2" style="max-height: 320px; overflow-y: auto; min-width: 260px;">
                            <li>
                                <a class="dropdown-item" href="#" t-on-click.prevent="showAllIndicators">
                                    Mostrar todos
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="#" t-on-click.prevent="hideAllIndicators">
                                    Ocultar todos
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"/></li>
                            <t t-foreach="currentData.indicators" t-as="indicator" t-key="indicator.id">
                                <li>
                                    <div class="dropdown-item form-check mb-0">
                                        <input type="checkbox" class="form-check-input"
                                               t-att-id="'indicator_toggle_' + indicator.id"
                                               t-att-checked="!state.hiddenIndicatorIds[indicator.id]"
                                               t-on-change="() => this.toggleIndicatorVisibility(indicator.id)"/>
                                        <label class="form-check-label" t-att-for="'indicator_toggle_' + indicator.id">
                                            <t t-esc="indicator.name"/>
                                        </label>
                                    </div>
                                </li>
                            </t>
                        </ul>
                    </div>
                    <button class="btn btn-sm btn-secondary" t-on-click="exportPdf">
                        Exportar PDF
                    </button>
                    <button class="btn btn-sm btn-secondary" t-on-click="exportXlsx">
                        Exportar Excel
                    </button>
                </div>
                <div class="o_control_panel_secondary p-2 border-top small text-muted" t-if="header">
                    <div>
                        <span class="me-3"><strong>Genética:</strong> <t t-esc="header.genetics_name"/></span>
                        <span class="me-3"><strong>Versión de Estándar:</strong> <t t-esc="header.version_name"/></span>
                    </div>
                    <!-- Una línea por lote seleccionado (con comparación, la info de todos). -->
                    <div t-foreach="header.batches_info or []" t-as="bi" t-key="bi.batch_id">
                        <span class="me-3"><strong><t t-esc="bi.name"/></strong></span>
                        <span class="me-3"><strong>Galpón:</strong> <t t-esc="bi.coop_names or '-'"/></span>
                        <span class="me-3">
                            <strong>Fecha de Ingreso a Galpón:</strong>
                            <t t-esc="bi.coop_date_from or '-'"/>
                        </span>
                        <span class="me-3"><strong>Fecha de Nacimiento:</strong> <t t-esc="bi.birth_date or '-'"/></span>
                        <!-- Aves Alojadas (foto a la Entrada en Producción, igual que la
                             ficha del lote); en crianza es la Cantidad de Aves ingresada. -->
                        <span><strong>Aves Alojadas:</strong> <t t-esc="bi.bird_count"/></span>
                    </div>
                </div>
            </div>

            <div class="o_content p-3">
                <t t-if="state.loading">
                    <p class="text-muted">Cargando...</p>
                </t>
                <t t-elif="state.error">
                    <div class="alert alert-danger" t-esc="state.error"/>
                </t>
                <t t-elif="!currentData or !currentData.rows.length">
                    <p class="text-muted">
                        No hay datos para el período
                        <t t-esc="state.period === 'crianza' ? 'Crianza' : 'Producción'"/>.
                    </p>
                </t>
                <t t-else="">
                    <!-- o_poultry_has_caret corre los offsets de las columnas fijas
                         cuando existe la columna de la flechita (modo comparación). -->
                    <table t-att-class="'table table-bordered table-sm table-hover' + (isComparison ? ' o_poultry_has_caret' : '')">
                        <thead>
                            <tr>
                                <th rowspan="2" t-if="isComparison" style="width: 28px;" class="o_poultry_col_caret"/>
                                <th rowspan="2" class="align-middle text-center o_poultry_col_week">Edad</th>
                                <th rowspan="2" class="align-middle text-center o_poultry_col_date">Fecha</th>
                                <th rowspan="2" class="align-middle text-center">Aves Vivas</th>
                                <t t-foreach="visibleIndicators" t-as="indicator" t-key="indicator.id">
                                    <th colspan="3" class="text-center">
                                        <t t-esc="indicator.name"/>
                                    </th>
                                </t>
                            </tr>
                            <tr>
                                <t t-foreach="visibleIndicators" t-as="indicator" t-key="indicator.id">
                                    <th class="text-center fw-normal">Bajo</th>
                                    <th class="text-center fw-normal">Alto</th>
                                    <th class="text-center fw-bold">Real</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="currentData.rows" t-as="row" t-key="row.week">
                                <tr t-att-style="isComparison ? 'cursor: pointer;' : ''"
                                    t-on-click="() => this.onRowClick(row.week)">
                                    <td class="text-center align-middle text-muted o_poultry_col_caret" t-if="isComparison">
                                        <i t-att-class="'fa ' + (state.expandedWeeks[row.week] ? 'fa-caret-down' : 'fa-caret-right')"/>
                                    </td>
                                    <td class="text-center fw-bold text-nowrap o_poultry_col_week">
                                        <t t-esc="row.week"/>
                                    </td>
                                    <td class="text-center text-nowrap o_poultry_col_date">
                                        <t t-esc="row.date"/>
                                    </td>
                                    <!-- Aves vivas al último día de la semana (semana en curso:
                                         a AYER; hoy nunca cuenta). Vacío = sin dato, no cero. -->
                                    <td class="text-center text-nowrap">
                                        <t t-if="row.live_birds !== null" t-esc="row.live_birds"/>
                                    </td>
                                    <t t-foreach="visibleIndicators" t-as="indicator" t-key="indicator.id">
                                        <t t-set="cell" t-value="row.cells[indicator.id]"/>
                                        <td class="text-center">
                                            <t t-if="cell.has_standard" t-esc="cell.value_low.toFixed(2)"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-if="cell.has_standard" t-esc="cell.value_high.toFixed(2)"/>
                                        </td>
                                        <td class="text-center"
                                            t-att-class="cell.out_of_range ? 'fw-bold' : ''"
                                            t-att-style="cell.real_color ? ('color: ' + cell.real_color + ';') : ''">
                                            <t t-if="cell.real_value !== null" t-esc="cell.real_value.toFixed(2)"/>
                                        </td>
                                    </t>
                                </tr>
                                <t t-if="isComparison and state.expandedWeeks[row.week]">
                                    <tr t-foreach="getRowBatches(row)" t-as="batchRow" t-key="batchRow.batch_id"
                                        class="table-light">
                                        <td class="o_poultry_col_caret"/>
                                        <td class="text-center o_poultry_col_week">
                                            <span class="badge rounded-pill text-bg-secondary">
                                                <t t-esc="batchRow.name"/>
                                            </span>
                                        </td>
                                        <td class="text-center text-nowrap small text-muted o_poultry_col_date">
                                            <t t-esc="batchRow.date or '-'"/>
                                        </td>
                                        <td class="text-center small text-muted">
                                            <t t-if="batchRow.live_birds !== null and batchRow.live_birds !== undefined"
                                               t-esc="batchRow.live_birds"/>
                                        </td>
                                        <t t-foreach="visibleIndicators" t-as="indicator" t-key="indicator.id">
                                            <t t-set="bv" t-value="batchRow.values[indicator.id]"/>
                                            <td class="text-center small text-muted" colspan="2">
                                                <t t-if="indicator_index === 0"
                                                   t-esc="batchRow.bird_count ? (batchRow.bird_count + ' aves') : ''"/>
                                            </td>
                                            <td class="text-center small"
                                                t-att-style="bv and bv.real_color ? ('color: ' + bv.real_color + '; font-weight: 500;') : ''">
                                                <t t-if="bv" t-esc="bv.real_value.toFixed(2)"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </t>
            </div>
        </div>
    </t>

</templates>
