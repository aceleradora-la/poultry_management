<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="poultry_management.PoultryFarmData">

    <!-- Lista: OF de Huevo sin Clasificar pendientes -->
    <t t-if="state.screen === 'list'">
        <div class="o_pw_header">
            <button type="button" class="o_pw_back" aria-label="Volver al inicio" t-on-click="props.onHome">
                <i class="fa fa-chevron-left"/>
            </button>
            <div>
                <div class="o_pw_title">OF Huevo sin Clasificar</div>
                <div class="o_pw_sub">Aves muertas y consumos del día</div>
            </div>
        </div>
        <div class="o_pw_body">
            <div t-if="!state.orders.length" class="o_pw_empty">
                No hay OF de Huevo sin Clasificar pendientes. Aparecen acá cuando la oficina confirma el Cierre de Galpón.
            </div>

            <t t-foreach="state.orders" t-as="order" t-key="order.id">
                <t t-set="st" t-value="orderStatus(order)"/>
                <button type="button" t-attf-class="o_pw_card o_pw_card_link {{ order.complete ? '' : 'o_pw_card_draft' }}"
                        t-att-disabled="state.busy" t-on-click="() => this.openOrder(order.id)">
                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                        <span class="o_pw_card_title"><t t-esc="order.coop"/> · <t t-esc="dateLabel(order.date)"/></span>
                        <span class="o_pw_muted">OF <t t-esc="order.order_name"/></span>
                    </div>
                    <div class="o_pw_muted"><t t-esc="fmt(order.eggs)"/> <t t-esc="order.eggs_uom"/> · postura del <t t-esc="order.date_label"/></div>
                    <div t-attf-class="{{ order.complete ? 'o_pw_ok' : 'o_pw_warn_text' }}">
                        <i t-attf-class="fa me-1 {{ order.complete ? 'fa-check' : 'fa-exclamation-circle' }}" aria-hidden="true"/>
                        <t t-esc="st.dead"/> · <t t-esc="st.lines"/>
                    </div>
                    <div class="o_pw_muted">
                        <t t-if="order.complete">Tocá para ver o corregir</t>
                        <t t-else="">Tocá para cargar</t>
                    </div>
                </button>
            </t>

            <div class="o_pw_hint mt-auto">
                La OF la crea la oficina al confirmar el Cierre de Galpón y la marca Hecha al otro día:
                hasta entonces se cargan y corrigen acá las aves muertas y los consumos.
            </div>
        </div>
    </t>

    <!-- Una OF: aves muertas y consumo por componente -->
    <t t-if="state.screen === 'order' and state.order">
        <div class="o_pw_header">
            <button type="button" class="o_pw_back" aria-label="Volver a la lista" t-on-click="loadList">
                <i class="fa fa-chevron-left"/>
            </button>
            <div>
                <div class="o_pw_title"><t t-esc="state.order.coop"/> · <t t-esc="dateLabel(state.order.date)"/></div>
                <div class="o_pw_sub">
                    OF <t t-esc="state.order.order_name"/> · <t t-esc="fmt(state.order.eggs)"/> <t t-esc="state.order.eggs_uom"/>
                    <t t-if="state.order.live_bird_count"> · <t t-esc="fmt(state.order.live_bird_count)"/> aves vivas</t>
                </div>
            </div>
        </div>
        <div class="o_pw_body" t-ref="form">
            <div class="o_pw_farm_card">
                <label for="o_pw_order_dead">Aves muertas del día</label>
                <div class="d-flex align-items-center gap-3">
                    <input id="o_pw_order_dead" data-field="dead" type="text" inputmode="numeric" enterkeyhint="next" autocomplete="off" placeholder="0"
                           t-attf-class="o_pw_farm_input {{ deadTooMany ? 'o_pw_input_error' : '' }}"
                           t-on-focus="selectOnFocus" t-on-keydown="onKeydown" t-model="state.form.dead"/>
                    <div class="o_pw_muted">
                        <div t-if="state.order.live_bird_count">de <t t-esc="fmt(state.order.live_bird_count)"/> aves vivas</div>
                        <div t-if="deadPct" t-esc="deadPct"/>
                    </div>
                </div>
                <div t-if="deadTooMany" class="o_pw_warn_text">
                    <i class="fa fa-exclamation-circle me-1" aria-hidden="true"/>Son más que las aves vivas del galpón: revisá el número.
                </div>
                <div t-else="" class="o_pw_hint text-start">Si no murió ninguna, dejalo vacío: al guardar queda en 0.</div>
            </div>

            <div class="o_pw_section_title">Consumos</div>
            <div t-if="!state.form.lines.length" class="o_pw_empty">La OF no tiene componentes para cargar.</div>
            <t t-foreach="state.form.lines" t-as="line" t-key="line.id">
                <div class="o_pw_farm_card">
                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                        <label t-attf-for="o_pw_line_{{ line.id }}" t-esc="line.product"/>
                        <span t-if="line.picked" class="o_pw_ok text-nowrap"><i class="fa fa-check me-1" aria-hidden="true"/>Confirmado</span>
                        <span t-else="" class="o_pw_muted text-nowrap">Propuesto por la lista</span>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <input t-attf-id="o_pw_line_{{ line.id }}" data-field="line" t-att-data-line="line.id" type="text" inputmode="decimal"
                               t-att-enterkeyhint="line_last ? 'done' : 'next'" autocomplete="off" placeholder="0"
                               class="o_pw_farm_input o_pw_farm_input_sm"
                               t-on-focus="selectOnFocus" t-on-keydown="onKeydown" t-model="line.qty"/>
                        <div t-if="line.isKg" class="o_pw_toggle" role="group" aria-label="Unidad">
                            <button type="button" t-attf-class="{{ line.unit === 'kg' ? 'active' : '' }}" t-on-click="() => this.setLineUnit(line, 'kg')">kg</button>
                            <button type="button" t-attf-class="{{ line.unit === 'bag' ? 'active' : '' }}" t-on-click="() => this.setLineUnit(line, 'bag')">bolsas de <t t-esc="fmt(state.order.feed_bag_kg)"/> kg</button>
                        </div>
                        <span t-else="" class="o_pw_unit" t-esc="line.uom"/>
                    </div>
                    <div class="o_pw_muted" t-esc="lineAlt(line)"/>
                </div>
            </t>

            <div class="o_pw_farm_card">
                <label for="o_pw_order_note">Observaciones</label>
                <textarea id="o_pw_order_note" rows="2" class="o_pw_textarea" placeholder="Opcional: quedan en el chatter de la OF" t-model="state.form.note"/>
            </div>
        </div>
        <div class="o_pw_footer">
            <button type="button" class="o_pw_btn o_pw_btn_primary" t-att-disabled="state.busy or deadTooMany" t-on-click="saveOrder">Guardar en la OF</button>
            <div class="o_pw_hint">Guardar confirma todos los consumos tal como se ven. La oficina marca la OF como hecha; hasta entonces se puede corregir acá.</div>
        </div>
    </t>

</t>

</templates>
