<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_form_poultry" model="ir.ui.view">
        <field name="name">mrp.bom.form.poultry</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <field name="product_tmpl_id" position="after">
                <field name="product_is_egg_production" invisible="1"/>
                <field name="use_for_egg_production"
                       invisible="not product_is_egg_production"/>
            </field>
        </field>
    </record>
</odoo>
