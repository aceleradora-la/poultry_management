<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Análisis de facturas: filtro de productos avícolas (huevos) -->
    <record id="view_account_invoice_report_search_poultry" model="ir.ui.view">
        <field name="name">account.invoice.report.search.poultry</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Productos avícolas (huevos)" name="filter_poultry_eggs"
                        domain="[('product_id.product_tmpl_id.is_egg_production', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- Las medidas Huevos, Cajones y Precio por cajón quedan disponibles en el
         desplegable "Medidas" del Análisis de facturas (son campos numéricos del
         modelo) sin agregarse por defecto al pivote: el pivote estándar no se toca. -->

    <!-- Líneas de asiento: columnas opcionales Huevos / Cajones -->
    <record id="view_move_line_tree_poultry" model="ir.ui.view">
        <field name="name">account.move.line.list.poultry</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="quantity_huevos" optional="hide" sum="Total Huevos"/>
                <field name="quantity_cajones" optional="hide" sum="Total Cajones"/>
            </xpath>
        </field>
    </record>
</odoo>
