<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_batch_indicator_weekly_value_tree" model="ir.ui.view">
        <field name="name">poultry.batch.indicator.weekly.value.tree</field>
        <field name="model">poultry.batch.indicator.weekly.value</field>
        <field name="arch" type="xml">
            <list string="Valores Reales Semanales de Indicadores" default_order="week desc">
                <field name="batch_id"/>
                <field name="indicator_id"/>
                <field name="week"/>
                <field name="period" widget="badge"
                       decoration-info="period == 'crianza'"
                       decoration-success="period == 'produccion'"/>
                <field name="week_date_from"/>
                <field name="week_date_to"/>
                <field name="value_low"/>
                <field name="value_high"/>
                <field name="real_value"/>
                <field name="source" widget="badge"
                       decoration-info="source == 'manual'"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_batch_indicator_weekly_value_manual_form" model="ir.ui.view">
        <field name="name">poultry.batch.indicator.weekly.value.manual.form</field>
        <field name="model">poultry.batch.indicator.weekly.value</field>
        <field name="arch" type="xml">
            <form string="Carga Manual de Indicador">
                <sheet>
                    <group>
                        <group>
                            <field name="batch_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="indicator_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="manual_date"/>
                            <!-- force_save: estos campos los completa el onchange a partir de la
                                 Fecha del Dato; sin force_save el cliente web no manda los campos
                                 readonly al guardar y la Semana de Vida llega vacía al servidor
                                 (que la exige por ser obligatoria). -->
                            <field name="week" readonly="1" force_save="1"/>
                            <field name="real_value"/>
                        </group>
                        <group>
                            <field name="source" readonly="1" force_save="1"/>
                            <field name="period" readonly="1" force_save="1"/>
                            <field name="week_date_from" readonly="1" force_save="1"/>
                            <field name="week_date_to" readonly="1" force_save="1"/>
                            <field name="value_low" readonly="1" force_save="1"/>
                            <field name="value_high" readonly="1" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_poultry_batch_indicator_weekly_value_manual_tree" model="ir.ui.view">
        <field name="name">poultry.batch.indicator.weekly.value.manual.tree</field>
        <field name="model">poultry.batch.indicator.weekly.value</field>
        <field name="arch" type="xml">
            <list string="Carga Manual de Indicadores" editable="bottom" default_order="batch_id, indicator_id, week">
                <field name="batch_id" options="{'no_create': False, 'no_create_edit': False}"/>
                <field name="indicator_id" options="{'no_create': False, 'no_create_edit': False}"/>
                <field name="manual_date"/>
                <!-- force_save: ver nota en el formulario de carga manual. -->
                <field name="week" readonly="1" force_save="1"/>
                <field name="period" readonly="1" force_save="1"/>
                <field name="real_value"/>
                <field name="value_low" readonly="1" force_save="1"/>
                <field name="value_high" readonly="1" force_save="1"/>
                <field name="week_date_from" column_invisible="1" force_save="1"/>
                <field name="week_date_to" column_invisible="1" force_save="1"/>
                <field name="source" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_poultry_indicator_manual_load" model="ir.actions.act_window">
        <field name="name">Carga Manual de Indicadores</field>
        <field name="res_model">poultry.batch.indicator.weekly.value</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('source', '=', 'manual')]</field>
        <field name="context">{'default_source': 'manual'}</field>
        <field name="view_id" ref="view_poultry_batch_indicator_weekly_value_manual_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cargar un valor semanal histórico a mano
            </p>
            <p>
                Para semanas del pasado sin dato del sistema (ej. histórico anterior a
                empezar a usar Odoo): cargá el Valor Real por Lote, Indicador y Semana
                de Vida. El recálculo NO los borra, tienen prioridad sobre el cálculo
                automático de esa semana, y los indicadores acumulados del sistema
                empalman a partir de ellos.
            </p>
        </field>
    </record>

    <record id="view_poultry_batch_indicator_weekly_value_pivot" model="ir.ui.view">
        <field name="name">poultry.batch.indicator.weekly.value.pivot</field>
        <field name="model">poultry.batch.indicator.weekly.value</field>
        <field name="arch" type="xml">
            <pivot string="Valores Reales Semanales de Indicadores">
                <field name="week" type="row"/>
                <field name="indicator_id" type="col"/>
                <field name="value_low" type="measure"/>
                <field name="value_high" type="measure"/>
                <field name="real_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_poultry_batch_indicator_weekly_value_search" model="ir.ui.view">
        <field name="name">poultry.batch.indicator.weekly.value.search</field>
        <field name="model">poultry.batch.indicator.weekly.value</field>
        <field name="arch" type="xml">
            <search string="Buscar Valores Reales Semanales">
                <field name="batch_id"/>
                <field name="indicator_id"/>
                <field name="week"/>
                <separator/>
                <filter string="Crianza" name="crianza" domain="[('period', '=', 'crianza')]"/>
                <filter string="Producción" name="produccion" domain="[('period', '=', 'produccion')]"/>
                <separator/>
                <filter string="Por Lote" name="by_batch" context="{'group_by': 'batch_id'}"/>
                <filter string="Por Indicador" name="by_indicator" context="{'group_by': 'indicator_id'}"/>
                <filter string="Por Semana" name="by_week" context="{'group_by': 'week'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_batch_indicator_weekly_value" model="ir.actions.act_window">
        <field name="name">Valores Reales Semanales de Indicadores</field>
        <field name="res_model">poultry.batch.indicator.weekly.value</field>
        <field name="view_mode">pivot,list</field>
        <field name="help" type="html">
            <p>
                Valores reales agregados por Semana de Vida (no semana calendario),
                ya calculados correctamente al guardar cada valor diario: suma de
                numerador/denominador para indicadores de tasa, último valor para
                acumulados. Incluye el Bajo/Alto del estándar (versión predeterminada
                de la genética) como medidas, para comparar Real vs. Estándar directo
                en el pivot. Explorá libremente agrupando por lote, indicador o semana.
            </p>
        </field>
    </record>

    <!-- El menú padre "Reportes" está definido en poultry_menus.xml -->
    <menuitem id="menu_poultry_batch_indicator_weekly_value"
              name="Valores Reales Semanales"
              parent="menu_poultry_reports_real_values"
              action="action_poultry_batch_indicator_weekly_value"
              sequence="10"/>

    <!-- Carga de histórico manual: va en Reportes, junto a los Valores Reales. -->
    <menuitem id="menu_poultry_indicator_manual_load"
              name="Carga Manual de Indicadores"
              parent="menu_poultry_reports_manual_load"
              action="action_poultry_indicator_manual_load"
              sequence="20"
              groups="poultry_management.poultry_manager"/>
</odoo>
