<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_batch_movement_tree" model="ir.ui.view">
        <field name="name">poultry.batch.movement.tree</field>
        <field name="model">poultry.batch.movement</field>
        <field name="arch" type="xml">
            <list string="Movimientos de Aves" decoration-muted="state == 'cancel'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="date"/>
                <field name="movement_type" widget="badge"
                       decoration-info="movement_type == 'ingreso'"
                       decoration-success="movement_type == 'traslado'"
                       decoration-danger="movement_type == 'retiro'"/>
                <field name="batch_id"/>
                <field name="origin_coop_id"/>
                <field name="dest_coop_id"/>
                <field name="bird_count"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_batch_movement_form" model="ir.ui.view">
        <field name="name">poultry.batch.movement.form</field>
        <field name="model">poultry.batch.movement</field>
        <field name="arch" type="xml">
            <form string="Movimiento de Aves">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state != 'done'"/>
                    <button name="action_set_to_draft" type="object" string="Volver a Borrador"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="movement_type" widget="radio" options="{'horizontal': true}"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="batch_id" readonly="state != 'draft'"
                                   options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="bird_count" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="origin_coop_id" readonly="state != 'draft'"
                                   invisible="movement_type == 'ingreso'"
                                   required="movement_type in ('traslado', 'retiro')"
                                   options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="dest_coop_id" readonly="state != 'draft'"
                                   invisible="movement_type == 'retiro'"
                                   required="movement_type in ('ingreso', 'traslado')"
                                   options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="truck_chassis_plate" readonly="state != 'draft'"/>
                            <field name="truck_trailer_plate" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notas adicionales..." readonly="state != 'draft'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_poultry_batch_movement_search" model="ir.ui.view">
        <field name="name">poultry.batch.movement.search</field>
        <field name="model">poultry.batch.movement</field>
        <field name="arch" type="xml">
            <search string="Buscar Movimientos de Aves">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="origin_coop_id"/>
                <field name="dest_coop_id"/>
                <separator/>
                <filter string="Ingreso" name="ingreso" domain="[('movement_type', '=', 'ingreso')]"/>
                <filter string="Traslado" name="traslado" domain="[('movement_type', '=', 'traslado')]"/>
                <filter string="Retiro" name="retiro" domain="[('movement_type', '=', 'retiro')]"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmados" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelados" name="cancel" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter string="Por Lote" name="by_batch" context="{'group_by': 'batch_id'}"/>
                <filter string="Por Galpón de Destino" name="by_dest_coop" context="{'group_by': 'dest_coop_id'}"/>
                <filter string="Por Fecha" name="by_date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_batch_movement" model="ir.actions.act_window">
        <field name="name">Movimientos de Aves</field>
        <field name="res_model">poultry.batch.movement</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo movimiento de aves
            </p>
            <p>
                Registra el Ingreso de aves a un galpón (con datos del camión), el
                Traslado de aves entre galpones (por ejemplo, de un galpón de Recría
                a uno Productivo), o el Retiro de aves que se van de la granja (venta,
                descarte o fin del lote). Al confirmar, actualiza automáticamente las
                asignaciones de lote a galpón.
            </p>
        </field>
    </record>
</odoo>
