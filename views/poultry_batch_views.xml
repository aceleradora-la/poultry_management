<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_batch_tree" model="ir.ui.view">
        <field name="name">poultry.batch.tree</field>
        <field name="model">poultry.batch</field>
        <field name="arch" type="xml">
            <list string="Lotes de Aves">
                <field name="code"/>
                <field name="name"/>
                <field name="genetics_id"/>
                <field name="birth_date"/>
                <field name="current_coop_ids" widget="many2many_tags"/>
                <field name="bird_count"/>
                <field name="live_bird_count"/>
                <field name="age_days"/>
                <field name="age_weeks"/>
                <field name="period" widget="badge"
                       decoration-info="period == 'crianza'"
                       decoration-success="period == 'produccion'"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_batch_form" model="ir.ui.view">
        <field name="name">poultry.batch.form</field>
        <field name="model">poultry.batch</field>
        <field name="arch" type="xml">
            <form string="Lote de Aves">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Activo" bg_color="text-success"
                            invisible="not active"/>
                    <group>
                        <group>
                            <field name="code" placeholder="Ej: LOTE-001"/>
                            <field name="name" placeholder="Ej: Lote Principal"/>
                            <field name="genetics_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="birth_date"/>
                        </group>
                        <group>
                            <field name="bird_count" readonly="1"/>
                            <field name="supplier_id" domain="[('supplier_rank', '>', 0)]"/>
                            <field name="current_coop_ids" widget="many2many_tags" readonly="1"/>
                            <field name="live_bird_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="age_days" readonly="1"/>
                            <field name="age_weeks" readonly="1"/>
                            <field name="period" readonly="1" widget="badge"
                                   decoration-info="period == 'crianza'"
                                   decoration-success="period == 'produccion'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Asignaciones a Galpón" name="coop_lines">
                            <field name="coop_line_ids" nolabel="1" context="{'default_batch_id': id}">
                                <list string="Asignaciones a Galpón" editable="bottom">
                                    <field name="coop_id" options="{'no_create': False, 'no_create_edit': False}"/>
                                    <field name="bird_count"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="dead_count"/>
                                    <field name="live_bird_count"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Movimientos de Aves" name="movements">
                            <field name="movement_ids" nolabel="1" readonly="1">
                                <list string="Movimientos de Aves">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="movement_type" widget="badge"
                                           decoration-info="movement_type == 'ingreso'"
                                           decoration-success="movement_type == 'traslado'"/>
                                    <field name="origin_coop_id"/>
                                    <field name="dest_coop_id"/>
                                    <field name="bird_count"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'draft'"
                                           decoration-success="state == 'done'"
                                           decoration-danger="state == 'cancel'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="notes" placeholder="Información adicional sobre el lote..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_poultry_batch_search" model="ir.ui.view">
        <field name="name">poultry.batch.search</field>
        <field name="model">poultry.batch</field>
        <field name="arch" type="xml">
            <search string="Buscar Lotes de Aves">
                <field name="name" string="Nombre" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="genetics_id"/>
                <field name="current_coop_ids"/>
                <separator/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Sin Asignar" name="no_coop" domain="[('current_coop_ids', '=', False)]"/>
                <separator/>
                <filter string="Por Fecha de Nacimiento" name="by_birth_date" context="{'group_by': 'birth_date'}"/>
                <filter string="Por Genética" name="by_genetics" context="{'group_by': 'genetics_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_batch" model="ir.actions.act_window">
        <field name="name">Lotes de Aves</field>
        <field name="res_model">poultry.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo lote de aves
            </p>
            <p>
                Los lotes de aves representan grupos de aves con características comunes
                como fecha de nacimiento y genética. Un lote puede darse de alta sin
                asignarlo todavía a un galpón, y asignarse luego a uno o más galpones
                con fecha y cantidad.
            </p>
        </field>
    </record>
</odoo>
