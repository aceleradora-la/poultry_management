<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Maestro de Jaulas de Muestreo: las ~10 jaulas identificadas por galpón que se
         pesan siempre en el Parte de Registro de Peso. -->
    <record id="view_poultry_cage_tree" model="ir.ui.view">
        <field name="name">poultry.cage.tree</field>
        <field name="model">poultry.cage</field>
        <field name="arch" type="xml">
            <list string="Jaulas de Muestreo" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="coop_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="code"/>
                <field name="name"/>
                <field name="notes" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_cage_form" model="ir.ui.view">
        <field name="name">poultry.cage.form</field>
        <field name="model">poultry.cage</field>
        <field name="arch" type="xml">
            <form string="Jaula de Muestreo">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="coop_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="code" placeholder="Ej: J-03"/>
                            <field name="name" placeholder="Ej: Jaula 3 - Fila B"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notas..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_poultry_cage_search" model="ir.ui.view">
        <field name="name">poultry.cage.search</field>
        <field name="model">poultry.cage</field>
        <field name="arch" type="xml">
            <search string="Buscar Jaulas">
                <field name="name" string="Jaula"
                       filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="coop_id"/>
                <separator/>
                <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Por Galpón" name="by_coop" context="{'group_by': 'coop_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_cage" model="ir.actions.act_window">
        <field name="name">Jaulas de Muestreo</field>
        <field name="res_model">poultry.cage</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_poultry_cage_search"/>
        <field name="context">{'search_default_by_coop': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Definí las jaulas de muestreo de cada galpón
            </p>
            <p>
                Son las jaulas identificadas (~10 por galpón) que se pesan siempre en el
                Parte de Registro de Peso. Cuando una jaula queda vacía o deja de usarse,
                archivala: los partes históricos la siguen mostrando.
            </p>
        </field>
    </record>
</odoo>
