<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_coop_bom_tree" model="ir.ui.view">
        <field name="name">poultry.coop.bom.tree</field>
        <field name="model">poultry.coop.bom</field>
        <field name="arch" type="xml">
            <list string="Listas de Materiales por Galpón" decoration-success="active == True">
                <field name="coop_id"/>
                <field name="bom_id"/>
                <field name="bom_product_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_coop_bom_form" model="ir.ui.view">
        <field name="name">poultry.coop.bom.form</field>
        <field name="model">poultry.coop.bom</field>
        <field name="arch" type="xml">
            <form string="Lista de Materiales por Galpón">
                <header>
                    <button name="action_set_active" type="object" string="Activar" 
                            class="oe_highlight" invisible="active"/>
                    <button name="action_set_inactive" type="object" string="Desactivar" 
                            invisible="not active"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Activa" bg_color="text-success" 
                            invisible="not active"/>
                    <group>
                        <group>
                            <field name="coop_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="bom_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="bom_product_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date" readonly="active"/>
                            <field name="active" readonly="1"/>
                            <field name="notes" placeholder="Notas adicionales..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_poultry_coop_bom_search" model="ir.ui.view">
        <field name="name">poultry.coop.bom.search</field>
        <field name="model">poultry.coop.bom</field>
        <field name="arch" type="xml">
            <search string="Buscar Listas de Materiales">
                <field name="coop_id"/>
                <field name="bom_id"/>
                <separator/>
                <filter string="Activas" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivas" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Por Galpón" name="by_coop" context="{'group_by': 'coop_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_coop_bom" model="ir.actions.act_window">
        <field name="name">Listas de Materiales por Galpón</field>
        <field name="res_model">poultry.coop.bom</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva lista de materiales para un galpón
            </p>
            <p>
                Cada galpón puede tener una lista de materiales activa que define
                el alimento balanceado que se está utilizando. Solo puede haber una lista activa por galpón.
            </p>
        </field>
    </record>
</odoo>

