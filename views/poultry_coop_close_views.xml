<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_coop_close_tree" model="ir.ui.view">
        <field name="name">poultry.coop.close.tree</field>
        <field name="model">poultry.coop.close</field>
        <field name="arch" type="xml">
            <list string="Cierres de Galpón"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'cancel'">
                <field name="coop_id"/>
                <field name="date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancel'"/>
                <field name="unclassified_production_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_coop_close_form" model="ir.ui.view">
        <field name="name">poultry.coop.close.form</field>
        <field name="model">poultry.coop.close</field>
        <field name="arch" type="xml">
            <form string="Cierre de Galpón">
                <header>
                    <button name="action_confirm" type="object" string="Confirmar Cierre"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_edit_wizard" type="object" string="Editar"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancelar Cierre"
                            class="btn-danger"
                            confirm="¿Está seguro de cancelar este cierre? Se desmantelará la OF de huevo sin clasificar y se desvincularán los partes."
                            invisible="state not in ('draft', 'done')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="coop_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="state" widget="statusbar"
                                   statusbar_visible="draft,done,cancel"/>
                        </group>
                        <group>
                            <field name="unclassified_production_id" readonly="1"
                                   invisible="not unclassified_production_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Partes de Producción" name="collections">
                            <field name="egg_collection_ids" nolabel="1" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="product_tmpl_id"/>
                                    <field name="total_eggs"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_poultry_coop_close" model="ir.actions.act_window">
        <field name="name">Cierres de Galpón</field>
        <field name="res_model">poultry.coop.close</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo cierre de galpón
            </p>
            <p>
                Use el menú "Cierre Galpón" para crear cierres. Los cierres agrupan los partes
                de producción procesados de un galpón en una fecha y generan la orden de
                producción de huevo sin clasificar.
            </p>
        </field>
    </record>
</odoo>
