<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_coop_close_wizard_form" model="ir.ui.view">
        <field name="name">poultry.coop.close.wizard.form</field>
        <field name="model">poultry.coop.close.wizard</field>
        <field name="arch" type="xml">
            <form string="Cierre de Galpón">
                <sheet>
                    <group>
                        <group>
                            <field name="coop_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Seleccione uno o más galpones"/>
                            <field name="date"/>
                            <field name="close_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirmar" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_poultry_coop_close_wizard" model="ir.actions.act_window">
        <field name="name">Cierre Galpón</field>
        <field name="res_model">poultry.coop.close.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
