<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de búsqueda para Reporte de Producción (filtros predefinidos) -->
    <record id="view_poultry_egg_collection_line_search_report" model="ir.ui.view">
        <field name="name">poultry.egg.collection.line.search.report</field>
        <field name="model">poultry.egg.collection.line</field>
        <field name="arch" type="xml">
            <search string="Buscar Líneas de Producción">
                <field name="collection_date" string="Fecha"/>
                <field name="collection_coop_id" string="Galpón"/>
                <field name="product_variant_id" string="Variante"/>
                <separator/>
                <filter string="Hoy" name="filter_today"
                        domain="[('collection_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Fecha" name="filter_date" date="collection_date"/>
            </search>
        </field>
    </record>

    <!-- Vista Pivot para Líneas de Recolección -->
    <record id="view_poultry_egg_collection_line_pivot" model="ir.ui.view">
        <field name="name">poultry.egg.collection.line.pivot</field>
        <field name="model">poultry.egg.collection.line</field>
        <field name="arch" type="xml">
            <pivot string="Reporte de Producción">
                <field name="collection_date" type="row" interval="day"/>
                <field name="collection_coop_id" type="col"/>
                <field name="attribute_value_id" type="row" string="Valor Atributo (Calibre)"/>
                <field name="total_produced_reference" type="measure" string="Total Huevos"/>
                <field name="total_boxes" type="measure" string="Total Cajones"/>
                <field name="average_weight_elaborated_aggregated" type="measure" string="Peso Medio Elaborado (g)"/>
            </pivot>
        </field>
    </record>
    
    <!-- Vista Tree para Líneas de Recolección (para el reporte) -->
    <record id="view_poultry_egg_collection_line_tree_report" model="ir.ui.view">
        <field name="name">poultry.egg.collection.line.tree.report</field>
        <field name="model">poultry.egg.collection.line</field>
        <field name="arch" type="xml">
            <list string="Líneas de Producción">
                <field name="collection_id"/>
                <field name="product_variant_id" string="Variante"/>
                <field name="collection_date" string="Fecha"/>
                <field name="collection_coop_id" string="Galpón"/>
                <field name="total_produced_reference" string="Total Huevos"/>
                <field name="total_boxes" string="Total Cajones"/>
                <field name="average_weight" string="Peso Medio"/>
                <field name="produced_box" string="Final PT"/>
                <field name="produced_map" string="Final PI"/>
                <field name="produced_egg" string="Final Huevo"/>
                <field name="weight_distribution_percent" string="% Distribución" widget="percentage"/>
            </list>
        </field>
    </record>
</odoo>

