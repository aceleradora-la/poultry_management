<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_genetics_standard_tree" model="ir.ui.view">
        <field name="name">poultry.genetics.standard.tree</field>
        <field name="model">poultry.genetics.standard</field>
        <field name="arch" type="xml">
            <list string="Estándares" decoration-info="period == 'crianza'"
                  decoration-success="period == 'produccion'">
                <field name="genetics_id"/>
                <field name="version_id"/>
                <field name="indicator_id"/>
                <field name="period" widget="badge"
                       decoration-info="period == 'crianza'"
                       decoration-success="period == 'produccion'"/>
                <field name="week"/>
                <field name="value_low"/>
                <field name="value_high"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_genetics_standard_form" model="ir.ui.view">
        <field name="name">poultry.genetics.standard.form</field>
        <field name="model">poultry.genetics.standard</field>
        <field name="arch" type="xml">
            <form string="Estándar de Genética">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="version_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="genetics_id" readonly="1"/>
                            <field name="indicator_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="period" widget="radio" options="{'horizontal': true}"/>
                            <field name="week"/>
                        </group>
                        <group>
                            <field name="value_low"/>
                            <field name="value_high"/>
                            <field name="notes" placeholder="Información adicional sobre este estándar..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_poultry_genetics_standard_search" model="ir.ui.view">
        <field name="name">poultry.genetics.standard.search</field>
        <field name="model">poultry.genetics.standard</field>
        <field name="arch" type="xml">
            <search string="Buscar Estándares">
                <field name="genetics_id"/>
                <field name="version_id"/>
                <field name="indicator_id"/>
                <field name="week"/>
                <separator/>
                <filter string="Crianza" name="crianza" domain="[('period', '=', 'crianza')]"/>
                <filter string="Producción" name="produccion" domain="[('period', '=', 'produccion')]"/>
                <separator/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <separator/>
                <filter string="Por Genética" name="by_genetics" context="{'group_by': 'genetics_id'}"/>
                <filter string="Por Versión" name="by_version" context="{'group_by': 'version_id'}"/>
                <filter string="Por Indicador" name="by_indicator" context="{'group_by': 'indicator_id'}"/>
                <filter string="Por Período" name="by_period" context="{'group_by': 'period'}"/>
                <filter string="Por Semana" name="by_week" context="{'group_by': 'week'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_genetics_standard" model="ir.actions.act_window">
        <field name="name">Estándares de Genética</field>
        <field name="res_model">poultry.genetics.standard</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
