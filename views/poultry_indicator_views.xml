<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_indicator_tree" model="ir.ui.view">
        <field name="name">poultry.indicator.tree</field>
        <field name="model">poultry.indicator</field>
        <field name="arch" type="xml">
            <list string="Indicadores de Genética">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="category"/>
                <field name="accumulation_type"/>
                <field name="period_scope"/>
                <field name="uom_id"/>
                <!-- Vacío = este indicador usa el cálculo interno, no el motor de
                     fórmulas. Editable en masa desde la lista para revertir varios. -->
                <field name="formula_numerator" optional="show"/>
                <field name="formula_denominator" optional="show"/>
                <field name="formula_mode" optional="show"/>
                <field name="standard_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_indicator_form" model="ir.ui.view">
        <field name="name">poultry.indicator.form</field>
        <field name="model">poultry.indicator</field>
        <field name="arch" type="xml">
            <form string="Indicador de Genética">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="code" placeholder="Ej: PESO_CORP"/>
                            <field name="name" placeholder="Ej: Peso Corporal"/>
                            <field name="uom_id" options="{'no_create': False, 'no_create_edit': False}"/>
                            <field name="category"/>
                            <field name="accumulation_type"/>
                            <field name="period_scope" widget="radio" options="{'horizontal': true}"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="real_value_source" placeholder="Ej: poultry.egg.collection:average_weight_elaborated"/>
                            <field name="notes" placeholder="Información adicional sobre este indicador..."/>
                            <field name="color_below" widget="color"/>
                            <field name="color_within" widget="color"/>
                            <field name="color_above" widget="color"/>
                        </group>
                    </group>
                    <group string="Fórmula del Valor Real">
                        <div class="text-muted mb-2" colspan="2">
                            El Valor Real de cada día se calcula como
                            <strong>Numerador ÷ Denominador × Factor</strong>, y el Modo de
                            Cálculo define cómo se combina con el histórico. Acá se elige la
                            BASE del indicador (Aves Vivas del día, Aves Alojadas o Cantidad
                            de Aves del lote) sin tocar código.
                            <br/>
                            Para una <strong>CANTIDAD del período</strong> (ej. Huevos de la
                            Semana, Kg de Alimento): Denominador "Ninguno" —o "Huevos por
                            Unidad" para verla en docenas o cajones— y
                            <strong>Agregación Semanal = Suma del período</strong>.
                            <br/>
                            Dejar el <strong>Modo de Cálculo vacío</strong> hace que el
                            indicador vuelva al cálculo interno de siempre.
                            <br/>
                            <strong>Después de cambiar la fórmula hay que correr
                            "Recalcular Indicadores de Producción"</strong> para rehacer el
                            pasado; los días nuevos ya salen con la fórmula nueva.
                        </div>
                        <group>
                            <field name="formula_numerator"/>
                            <field name="formula_denominator"/>
                            <field name="egg_group_size"
                                   invisible="formula_denominator != 'egg_units' and category != 'feed_conversion'"/>
                        </group>
                        <group>
                            <field name="formula_factor" widget="radio" options="{'horizontal': true}"/>
                            <field name="formula_mode"/>
                            <field name="weekly_aggregation"/>
                        </group>
                    </group>
                    <group>
                        <field name="applicable_version_ids" widget="many2many_tags"
                               placeholder="Vacío = aplica a todas las Versiones de Estándar"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_poultry_indicator_search" model="ir.ui.view">
        <field name="name">poultry.indicator.search</field>
        <field name="model">poultry.indicator</field>
        <field name="arch" type="xml">
            <search string="Buscar Indicadores">
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <separator/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Con Fórmula" name="with_formula" domain="[('formula_mode', '!=', False)]"/>
                <filter string="Con Cálculo Interno" name="without_formula" domain="[('formula_mode', '=', False)]"/>
                <separator/>
                <filter string="Por Categoría" name="by_category" context="{'group_by': 'category'}"/>
                <filter string="Por Modo de Cálculo" name="by_formula_mode" context="{'group_by': 'formula_mode'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_indicator" model="ir.actions.act_window">
        <field name="name">Indicadores de Genética</field>
        <field name="res_model">poultry.indicator</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo indicador de genética
            </p>
            <p>
                Los indicadores definen qué se mide en los estándares de genética
                (ej. Mortalidad, Peso Corporal, Consumo de Alimento) y su Unidad de Medida.
            </p>
        </field>
    </record>
</odoo>
