<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Configuración del Módulo -->
    <record id="view_poultry_config_settings_form" model="ir.ui.view">
        <field name="name">poultry.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="Configuración de Gestión Avícola" class="oe_form_configuration">
                <header>
                    <button string="Aplicar" type="object" name="execute" class="oe_highlight"/>
                    <button string="Cancelar" type="object" name="cancel" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Parámetros Generales">
                            <field name="poultry_unclassified_egg_product_id" 
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   help="Producto que se utilizará para representar el huevo sin clasificar en las recolecciones de producción."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para la configuración -->
    <record id="action_poultry_config_settings" model="ir.actions.act_window">
        <field name="name">Gestión de Granja</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="view_id" ref="view_poultry_config_settings_form"/>
    </record>

    <menuitem id="menu_poultry_management_root" 
              name="Gestión Avícola" 
              sequence="100"
              web_icon="poultry_management,static/description/icon.png"/>

    <!-- Menú Principal: Producción -->
    <menuitem id="menu_poultry_egg_collection" 
              name="Producción" 
              parent="menu_poultry_management_root" 
              action="action_poultry_egg_collection" 
              sequence="10"/>

    <!-- Menú: Registro Aves Muertas -->
    <menuitem id="menu_poultry_mortality" 
              name="Registro Aves Muertas" 
              parent="menu_poultry_management_root" 
              action="action_poultry_mortality" 
              sequence="20"/>

    <!-- Menú: Reportes -->
    <menuitem id="menu_poultry_reports" 
              name="Reportes" 
              parent="menu_poultry_management_root" 
              sequence="30"/>

    <!-- Menú: Configuración -->
    <menuitem id="menu_poultry_configuration" 
              name="Configuración" 
              parent="menu_poultry_management_root" 
              sequence="40"/>

    <!-- Submenús de Configuración -->
    <menuitem id="menu_poultry_coop" 
              name="Galpones" 
              parent="menu_poultry_configuration" 
              action="action_poultry_coop" 
              sequence="10"/>

    <menuitem id="menu_poultry_batch" 
              name="Lotes de Aves" 
              parent="menu_poultry_configuration" 
              action="action_poultry_batch" 
              sequence="20"/>

    <menuitem id="menu_poultry_genetics" 
              name="Genéticas" 
              parent="menu_poultry_configuration" 
              action="action_poultry_genetics" 
              sequence="30"/>

    <menuitem id="menu_poultry_genetics_standards" 
              name="Estándares de Genética" 
              parent="menu_poultry_configuration" 
              action="action_poultry_genetics_standard" 
              sequence="40"/>

    <!-- Menú en Ajustes de Odoo -->
    <menuitem id="menu_poultry_settings" 
              name="Gestión de Granja" 
              parent="base.menu_ir_config_parameters" 
              action="action_poultry_config_settings" 
              sequence="100"/>
</odoo>

