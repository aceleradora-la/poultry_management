<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Solo Usuario Avícola (el Gestor lo hereda): el Operador de Campo, que tiene
         permiso de lectura sobre los partes de peso, no ve esta app sino Avícola Campo. -->
    <menuitem id="menu_poultry_management_root"
              name="Gestión Avícola"
              sequence="100"
              groups="poultry_management.poultry_user"
              web_icon="poultry_management,static/description/icon.svg"/>

    <!-- Menú Principal: Producción -->
    <menuitem id="menu_poultry_egg_collection" 
              name="Producción" 
              parent="menu_poultry_management_root" 
              action="action_poultry_egg_collection" 
              sequence="10"/>

    <!-- Menú: Pesaje de Aves (pesadas, calendario y planes; pedido del usuario del
         2026-11-12: la programación de pesajes vive acá, no en Producción). El menú viejo
         con la acción pasa a ser el hijo "Pesadas". -->
    <menuitem id="menu_poultry_weight_root"
              name="Pesaje de Aves"
              parent="menu_poultry_management_root"
              sequence="15"/>
    <menuitem id="menu_poultry_weight_record"
              name="Pesadas"
              parent="menu_poultry_weight_root"
              action="action_poultry_weight_record"
              sequence="10"/>
    <menuitem id="menu_poultry_weight_calendar"
              name="Calendario"
              parent="menu_poultry_weight_root"
              action="action_poultry_weight_record_calendar"
              sequence="20"/>
    <menuitem id="menu_poultry_weight_plan"
              name="Planes de Pesaje"
              parent="menu_poultry_weight_root"
              action="action_poultry_weight_plan"
              sequence="30"/>
    <menuitem id="menu_poultry_weight_plan_batch"
              name="Plan por Lote"
              parent="menu_poultry_weight_root"
              action="action_poultry_weight_plan_batch"
              sequence="40"/>

    <!-- App Avícola Campo: app aparte en el inicio de Odoo para lo que se carga desde el
         celular en el galpón. Solo la ven los Operadores de Campo (privilegio propio). -->
    <menuitem id="menu_poultry_field_root"
              name="Avícola Campo"
              sequence="101"
              action="action_poultry_weighing"
              groups="poultry_management.poultry_field_user"
              web_icon="poultry_management,static/description/icon_field.svg"/>

    <!-- Menú: Cierres -->
    <menuitem id="menu_poultry_closes"
              name="Cierres" 
              parent="menu_poultry_management_root" 
              sequence="20"/>
    <menuitem id="menu_poultry_coop_close_wizard" 
              name="Cierre Galpón" 
              parent="menu_poultry_closes" 
              action="action_poultry_coop_close_wizard" 
              sequence="10"/>
    <menuitem id="menu_poultry_coop_close" 
              name="Cierres de Galpón" 
              parent="menu_poultry_closes" 
              action="action_poultry_coop_close" 
              sequence="20"/>

    <!-- Menú: Movimiento de Aves -->
    <menuitem id="menu_poultry_batch_movement"
              name="Movimiento de Aves"
              parent="menu_poultry_management_root"
              action="action_poultry_batch_movement"
              sequence="25"/>

    <!-- Menú: Sanidad -->
    <menuitem id="menu_poultry_health"
              name="Sanidad"
              parent="menu_poultry_management_root"
              sequence="30"/>
    <menuitem id="menu_poultry_vaccination"
              name="Aplicaciones de Vacunas"
              parent="menu_poultry_health"
              action="action_poultry_vaccination"
              sequence="10"/>
    <menuitem id="menu_poultry_vaccination_compliance"
              name="Cumplimiento de Vacunación"
              parent="menu_poultry_health"
              action="action_poultry_vaccination_compliance"
              sequence="20"/>

    <!-- Menú: Reportes -->
    <menuitem id="menu_poultry_reports"
              name="Reportes" 
              parent="menu_poultry_management_root" 
              sequence="40"/>

    <!-- Submenús de Reportes. Los padres NO llevan groups: Odoo oculta solo un
         menú padre cuando todos sus hijos están ocultos para el usuario. Los hijos
         se declaran en sus propios archivos (este se carga primero, así siempre
         encuentran al padre). -->
    <menuitem id="menu_poultry_reports_operation"
              name="Operación"
              parent="menu_poultry_reports"
              sequence="10"/>

    <menuitem id="menu_poultry_weight_record_cage"
              name="Pesos por Jaula"
              parent="menu_poultry_reports_operation"
              action="action_poultry_weight_record_cage"
              sequence="50"/>

    <menuitem id="menu_poultry_reports_manual_load"
              name="Carga Manual"
              parent="menu_poultry_reports"
              sequence="20"/>

    <menuitem id="menu_poultry_reports_real_values"
              name="Valores Reales"
              parent="menu_poultry_reports"
              sequence="30"/>

    <menuitem id="menu_poultry_reports_standards_life_week"
              name="Estándares Semana Vida"
              parent="menu_poultry_reports"
              sequence="40"/>

    <menuitem id="menu_poultry_reports_standards_calendar_week"
              name="Estándares Semana"
              parent="menu_poultry_reports"
              sequence="50"/>

    <menuitem id="menu_poultry_stock_dashboard"
              name="Cobertura de stock"
              parent="menu_poultry_reports_operation"
              action="action_poultry_stock_dashboard"
              sequence="40"
              groups="stock.group_stock_user"/>

    <menuitem id="menu_poultry_batch_indicator_value"
              name="Valores Reales de Indicadores"
              parent="menu_poultry_reports_real_values"
              action="action_poultry_batch_indicator_value"
              sequence="20"/>

    <!-- Menú: Configuración -->
    <menuitem id="menu_poultry_configuration"
              name="Configuración"
              parent="menu_poultry_management_root"
              sequence="50"/>

    <!-- Subgrupos de Configuración (sin acción: solo agrupan visualmente los submenús) -->
    <menuitem id="menu_poultry_configuration_genetics"
              name="Genética"
              parent="menu_poultry_configuration"
              sequence="10"/>

    <menuitem id="menu_poultry_configuration_batches"
              name="Lotes"
              parent="menu_poultry_configuration"
              sequence="20"/>

    <menuitem id="menu_poultry_configuration_health"
              name="Sanidad"
              parent="menu_poultry_configuration"
              sequence="25"/>

    <menuitem id="menu_poultry_configuration_general"
              name="Configuración General"
              parent="menu_poultry_configuration"
              sequence="30"/>

    <!-- Genética -->
    <menuitem id="menu_poultry_genetics"
              name="Genéticas"
              parent="menu_poultry_configuration_genetics"
              action="action_poultry_genetics"
              sequence="10"/>

    <menuitem id="menu_poultry_indicator"
              name="Indicadores de Genética"
              parent="menu_poultry_configuration_genetics"
              action="action_poultry_indicator"
              sequence="20"/>

    <menuitem id="menu_poultry_genetics_standard_version"
              name="Versiones de Estándar"
              parent="menu_poultry_configuration_genetics"
              action="action_poultry_genetics_standard_version"
              sequence="30"/>

    <menuitem id="menu_poultry_genetics_standards"
              name="Estándares de Genética"
              parent="menu_poultry_configuration_genetics"
              action="action_poultry_genetics_standard"
              sequence="40"/>

    <!-- Lotes -->
    <menuitem id="menu_poultry_batch"
              name="Lotes de Aves"
              parent="menu_poultry_configuration_batches"
              action="action_poultry_batch"
              sequence="10"/>

    <!-- Sanidad (Configuración) -->
    <menuitem id="menu_poultry_vaccine"
              name="Vacunas"
              parent="menu_poultry_configuration_health"
              action="action_poultry_vaccine"
              sequence="10"/>

    <menuitem id="menu_poultry_vaccination_plan"
              name="Planes de Vacunación"
              parent="menu_poultry_configuration_health"
              action="action_poultry_vaccination_plan"
              sequence="20"/>

    <menuitem id="menu_poultry_batch_vaccination_plan"
              name="Asignaciones de Planes"
              parent="menu_poultry_configuration_health"
              action="action_poultry_batch_vaccination_plan"
              sequence="30"/>

    <!-- Configuración General -->
    <menuitem id="menu_poultry_coop"
              name="Galpones"
              parent="menu_poultry_configuration_general"
              action="action_poultry_coop"
              sequence="10"/>

    <menuitem id="menu_poultry_cage"
              name="Jaulas"
              parent="menu_poultry_configuration_general"
              action="action_poultry_cage"
              sequence="12"/>

    <menuitem id="menu_poultry_cage_sampling"
              name="Jaulas de Muestreo"
              parent="menu_poultry_configuration_general"
              action="action_poultry_cage_sampling"
              sequence="15"/>

    <menuitem id="menu_poultry_uom"
              name="Unidades de Medida"
              parent="menu_poultry_configuration_general"
              action="action_uom_poultry"
              sequence="20"/>
</odoo>

