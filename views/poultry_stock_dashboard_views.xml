<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_search_poultry_cover" model="ir.ui.view">
        <field name="name">product.product.search.poultry.cover</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <search string="Cobertura de stock">
                <field name="name"/>
                <field name="default_code"/>
                <separator/>
                <searchpanel>
                    <field name="categ_id" icon="fa-filter" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="product_product_kanban_poultry_cover" model="ir.ui.view">
        <field name="name">product.product.kanban.poultry.cover</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <kanban create="false"
                    decoration-success="poultry_cover_signal == 'green'"
                    decoration-warning="poultry_cover_signal == 'yellow'"
                    decoration-danger="poultry_cover_signal == 'red'"
                    decoration-muted="poultry_cover_signal == 'neutral'">
                <field name="name"/>
                <field name="default_code"/>
                <field name="image_128"/>
                <field name="qty_available"/>
                <field name="uom_id"/>
                <field name="poultry_cover_daily_avg"/>
                <field name="poultry_cover_days_display"/>
                <field name="poultry_cover_signal"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="o_kanban_record_top d-flex mb-2">
                                <field name="image_128" widget="image" options="{'img_class': 'rounded-3 object-fit-contain'}" class="o_kanban_image flex-shrink-0 me-2"/>
                                <div class="o_kanban_record_headings flex-grow-1">
                                    <strong class="o_kanban_record_title d-block"><field name="name"/></strong>
                                    <span class="text-muted small"><field name="default_code"/></span>
                                </div>
                                <field name="poultry_cover_signal" class="ms-1"/>
                            </div>
                            <div class="row small g-1 mt-1">
                                <div class="col-6">
                                    <span class="text-muted">A la mano</span>
                                    <div><field name="qty_available"/> <field name="uom_id" readonly="1" class="d-inline"/></div>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted">Consumo/día (7d)</span>
                                    <div><field name="poultry_cover_daily_avg"/></div>
                                </div>
                                <div class="col-12 mt-1">
                                    <span class="text-muted">Días cobertura</span>
                                    <div class="fw-bold"><field name="poultry_cover_days_display"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="product_product_tree_poultry_cover" model="ir.ui.view">
        <field name="name">product.product.tree.poultry.cover</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list string="Cobertura de stock" create="false"
                  decoration-success="poultry_cover_signal == 'green'"
                  decoration-warning="poultry_cover_signal == 'yellow'"
                  decoration-danger="poultry_cover_signal == 'red'"
                  decoration-muted="poultry_cover_signal == 'neutral'">
                <field name="default_code" optional="show"/>
                <field name="name"/>
                <field name="categ_id" optional="hide"/>
                <field name="qty_available" string="A la mano"/>
                <field name="uom_id" optional="hide"/>
                <field name="poultry_cover_daily_avg" string="Consumo/día"/>
                <field name="poultry_cover_days_display" string="Días"/>
                <field name="poultry_cover_signal" string="Semáforo"/>
            </list>
        </field>
    </record>

    <record id="action_poultry_stock_dashboard" model="ir.actions.server">
        <field name="name">Cobertura de stock</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">action = env['product.product'].action_open_poultry_stock_dashboard()</field>
    </record>
</odoo>
