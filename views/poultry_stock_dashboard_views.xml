<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista derivada (mode="primary"): hereda la búsqueda estándar de variantes pero NO se
         inyecta en el resto de las búsquedas de product.product. Como extensión, su <searchpanel>
         se sumaba al del Reporte de Existencias (stock.product_search_form_view_stock_report) y
         rompía esa pantalla con "Search tag can only contain one search panel". -->
    <record id="product_product_search_poultry_cover" model="ir.ui.view">
        <field name="name">product.product.search.poultry.cover</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Con datos de cobertura" name="poultry_cover_tablero_con_datos"
                        domain="[('poultry_cover_signal', 'in', ('red', 'yellow', 'green'))]"/>
                <searchpanel>
                    <field name="categ_id" string="Categoría" icon="fa-filter" enable_counters="1" hierarchize="1" select="multi"/>
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="product_product_kanban_poultry_cover" model="ir.ui.view">
        <field name="name">product.product.kanban.poultry.cover</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <kanban create="false"
                    class="o_poultry_stock_cover_dashboard"
                    default_group_by="poultry_cover_signal"
                    default_order="poultry_cover_sort_days asc, id asc"
                    decoration-success="poultry_cover_signal == 'green'"
                    decoration-danger="poultry_cover_signal == 'red'"
                    decoration-muted="poultry_cover_signal == 'neutral'">
                <field name="poultry_cover_signal"/>
                <field name="poultry_cover_sort_days" invisible="1"/>
                <field name="poultry_cover_forecast_signal"/>
                <field name="display_name"/>
                <field name="name"/>
                <field name="default_code"/>
                <field name="image_128"/>
                <field name="qty_available"/>
                <field name="virtual_available"/>
                <field name="uom_id"/>
                <field name="poultry_cover_daily_avg"/>
                <field name="poultry_cover_days_display"/>
                <field name="poultry_cover_forecast_days_display"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="o_kanban_record_top d-flex mb-2">
                                <field name="image_128" widget="image" options="{'img_class': 'rounded-3 object-fit-contain'}" class="o_kanban_image flex-shrink-0 me-2"/>
                                <div class="o_kanban_record_headings flex-grow-1 min-w-0">
                                    <strong class="o_kanban_record_title d-block"><field name="display_name"/></strong>
                                    <span t-if="record.default_code.raw_value" class="text-muted small d-block">
                                        Ref. <field name="default_code"/>
                                    </span>
                                    <div class="d-flex flex-wrap align-items-end gap-3 mt-2">
                                        <div class="o_poultry_cover_disk-group o_poultry_cover_disk-group--real text-center">
                                            <div class="text-muted text-uppercase mb-1 o_poultry_cover_disk-label">Real</div>
                                            <t t-if="record.poultry_cover_signal.raw_value == 'red'">
                                                <div class="o_poultry_cover_disk o_poultry_cover_disk--red" title="Cobertura real: rojo">
                                                    <field name="poultry_cover_days_display" readonly="1" nolabel="1"/>
                                                </div>
                                            </t>
                                            <t t-elif="record.poultry_cover_signal.raw_value == 'yellow'">
                                                <div class="o_poultry_cover_disk o_poultry_cover_disk--yellow" title="Cobertura real: amarillo">
                                                    <field name="poultry_cover_days_display" readonly="1" nolabel="1"/>
                                                </div>
                                            </t>
                                            <t t-elif="record.poultry_cover_signal.raw_value == 'green'">
                                                <div class="o_poultry_cover_disk o_poultry_cover_disk--green" title="Cobertura real: verde">
                                                    <field name="poultry_cover_days_display" readonly="1" nolabel="1"/>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <div class="o_poultry_cover_disk o_poultry_cover_disk--neutral" title="Cobertura real: sin datos">
                                                    <field name="poultry_cover_days_display" readonly="1" nolabel="1"/>
                                                </div>
                                            </t>
                                        </div>
                                        <div class="o_poultry_cover_disk-group o_poultry_cover_disk-group--fcst text-center">
                                            <div class="text-muted text-uppercase mb-1 o_poultry_cover_disk-label">Pronóst.</div>
                                            <t t-if="record.poultry_cover_forecast_signal.raw_value == 'red'">
                                                <div class="o_poultry_cover_disk o_poultry_cover_disk--red" title="Cobertura pronóstico: rojo">
                                                    <field name="poultry_cover_forecast_days_display" readonly="1" nolabel="1"/>
                                                </div>
                                            </t>
                                            <t t-elif="record.poultry_cover_forecast_signal.raw_value == 'yellow'">
                                                <div class="o_poultry_cover_disk o_poultry_cover_disk--yellow" title="Cobertura pronóstico: amarillo">
                                                    <field name="poultry_cover_forecast_days_display" readonly="1" nolabel="1"/>
                                                </div>
                                            </t>
                                            <t t-elif="record.poultry_cover_forecast_signal.raw_value == 'green'">
                                                <div class="o_poultry_cover_disk o_poultry_cover_disk--green" title="Cobertura pronóstico: verde">
                                                    <field name="poultry_cover_forecast_days_display" readonly="1" nolabel="1"/>
                                                </div>
                                            </t>
                                            <t t-else="">
                                                <div class="o_poultry_cover_disk o_poultry_cover_disk--neutral" title="Cobertura pronóstico: sin datos">
                                                    <field name="poultry_cover_forecast_days_display" readonly="1" nolabel="1"/>
                                                </div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row small g-1 mt-1">
                                <div class="col-6">
                                    <span class="text-muted">A la mano (empresa)</span>
                                    <div><field name="qty_available"/> <field name="uom_id" readonly="1" class="d-inline"/></div>
                                    <div class="mt-1 pt-1 border-top border-light">
                                        <span class="text-muted">Pronosticada</span>
                                        <div><field name="virtual_available"/> <field name="uom_id" readonly="1" class="d-inline"/></div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted">Consumo/día</span>
                                    <div><field name="poultry_cover_daily_avg"/></div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_poultry_stock_dashboard" model="ir.actions.server">
        <field name="name">Cobertura de stock</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="state">code</field>
        <field name="code">action = env['product.product'].action_open_poultry_stock_dashboard()</field>
    </record>
</odoo>
