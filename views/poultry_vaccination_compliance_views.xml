<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cumplimiento de Vacunación: vista SQL de solo lectura, una fila por línea de
         plan × asignación. El botón "Registrar Aplicación" abre el formulario de
         aplicación precargado desde la fila. -->
    <record id="view_poultry_vaccination_compliance_tree" model="ir.ui.view">
        <field name="name">poultry.vaccination.compliance.tree</field>
        <field name="model">poultry.vaccination.compliance</field>
        <field name="arch" type="xml">
            <list string="Cumplimiento de Vacunación" create="false" edit="false" delete="false"
                  decoration-danger="status == 'overdue'"
                  decoration-success="status == 'applied'">
                <field name="batch_id"/>
                <field name="plan_id"/>
                <field name="week"/>
                <field name="vaccine_id"/>
                <field name="due_date"/>
                <field name="applied_date"/>
                <field name="vaccination_id" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'applied'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'overdue'"/>
                <field name="active_assignment" optional="hide"/>
                <button name="action_register_vaccination" string="Registrar Aplicación"
                        type="object" icon="fa-medkit"
                        invisible="status == 'applied' or not active_assignment"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_vaccination_compliance_search" model="ir.ui.view">
        <field name="name">poultry.vaccination.compliance.search</field>
        <field name="model">poultry.vaccination.compliance</field>
        <field name="arch" type="xml">
            <search string="Buscar Cumplimiento">
                <field name="batch_id"/>
                <field name="plan_id"/>
                <field name="vaccine_id"/>
                <separator/>
                <filter string="Asignaciones Vigentes" name="active_assignment"
                        domain="[('active_assignment', '=', True)]"/>
                <separator/>
                <filter string="Pendientes" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="Vencidas" name="overdue" domain="[('status', '=', 'overdue')]"/>
                <filter string="Aplicadas" name="applied" domain="[('status', '=', 'applied')]"/>
                <separator/>
                <filter string="Por Lote" name="by_batch" context="{'group_by': 'batch_id'}"/>
                <filter string="Por Plan" name="by_plan" context="{'group_by': 'plan_id'}"/>
                <filter string="Por Estado" name="by_status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_vaccination_compliance" model="ir.actions.act_window">
        <field name="name">Cumplimiento de Vacunación</field>
        <field name="res_model">poultry.vaccination.compliance</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_poultry_vaccination_compliance_search"/>
        <field name="context">{'search_default_active_assignment': 1, 'search_default_by_batch': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay planes de vacunación asignados
            </p>
            <p>
                Asigná un Plan de Vacunación a cada lote para ver acá qué vacunas están
                Pendientes, Vencidas o Aplicadas según su Semana de Vida.
            </p>
        </field>
    </record>
</odoo>
