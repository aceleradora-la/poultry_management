<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_poultry_vaccination_tree" model="ir.ui.view">
        <field name="name">poultry.vaccination.tree</field>
        <field name="model">poultry.vaccination</field>
        <field name="arch" type="xml">
            <list string="Aplicaciones de Vacunas">
                <field name="name"/>
                <field name="date"/>
                <field name="batch_id"/>
                <field name="coop_id" optional="show"/>
                <field name="batch_age_weeks"/>
                <field name="vaccine_id"/>
                <field name="route" optional="show"/>
                <field name="dose" optional="show"/>
                <field name="lot_number" optional="show"/>
                <field name="applied_by_id" optional="show"/>
                <field name="plan_line_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_poultry_vaccination_form" model="ir.ui.view">
        <field name="name">poultry.vaccination.form</field>
        <field name="model">poultry.vaccination</field>
        <field name="arch" type="xml">
            <form string="Aplicación de Vacuna">
                <header>
                    <button name="action_done" string="Confirmar Aplicación" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state not in ('draft', 'done')"/>
                    <button name="action_draft" string="Volver a Borrador" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Lote y Fecha">
                            <field name="batch_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="allowed_coop_ids" invisible="1"/>
                            <field name="coop_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   placeholder="Vacío = todo el lote"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="batch_age_weeks" readonly="1"/>
                            <field name="bird_count" readonly="1"/>
                        </group>
                        <group string="Vacuna">
                            <field name="vaccine_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="assigned_plan_ids" invisible="1"/>
                            <field name="plan_line_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="route" readonly="state != 'draft'"/>
                            <field name="dose" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Partida del Producto">
                        <group>
                            <field name="lot_number" readonly="state != 'draft'"/>
                            <field name="expiry_date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="laboratory" readonly="state != 'draft'"/>
                            <field name="applied_by_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </group>
                    </group>
                    <field name="observations" placeholder="Observaciones de la aplicación..."
                           readonly="state != 'draft'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_poultry_vaccination_search" model="ir.ui.view">
        <field name="name">poultry.vaccination.search</field>
        <field name="model">poultry.vaccination</field>
        <field name="arch" type="xml">
            <search string="Buscar Aplicaciones de Vacunas">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="vaccine_id"/>
                <field name="lot_number"/>
                <field name="coop_id"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Aplicadas" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Fuera de Plan" name="no_plan_line"
                        domain="[('plan_line_id', '=', False)]"/>
                <separator/>
                <filter string="Por Lote" name="by_batch" context="{'group_by': 'batch_id'}"/>
                <filter string="Por Vacuna" name="by_vaccine" context="{'group_by': 'vaccine_id'}"/>
                <filter string="Por Mes" name="by_month" context="{'group_by': 'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_poultry_vaccination" model="ir.actions.act_window">
        <field name="name">Aplicaciones de Vacunas</field>
        <field name="res_model">poultry.vaccination</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_poultry_vaccination_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registrá una aplicación de vacuna
            </p>
            <p>
                Cada aplicación guarda la vacuna, la partida del producto (número de lote,
                vencimiento y laboratorio), la dosis, la vía y el responsable. Si se
                vincula a la línea del Plan de Vacunación del lote, cuenta para el
                Cumplimiento de Vacunación.
            </p>
        </field>
    </record>
</odoo>
