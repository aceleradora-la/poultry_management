<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Diálogo de confirmación al procesar una OF de cierre con datos en cero
         (Aves Muertas y/o Consumo de Alimento): el operador puede confirmar que
         los ceros son reales o volver a cargar los datos. Cada aviso se muestra
         solo si su condición aplica; si ambas, un único diálogo con los dos. -->
    <record id="view_poultry_zero_mortality_confirm_wizard_form" model="ir.ui.view">
        <field name="name">poultry.zero.mortality.confirm.wizard.form</field>
        <field name="model">poultry.zero.mortality.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar datos en cero">
                <div class="alert alert-warning" role="alert" invisible="not pending_names">
                    <strong>No se cargaron Aves Muertas.</strong>
                    <p class="mb-0">
                        La/s OF <field name="pending_names" readonly="1" nolabel="1" class="o_inline"/>
                        se van a procesar con <strong>0 aves muertas</strong>.
                        Si ese día sí hubo mortandad, cancelá y cargala en la solapa
                        "Aves Muertas" antes de procesar.
                    </p>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not pending_feed_names">
                    <strong>No se cargó Consumo de Alimento.</strong>
                    <p class="mb-0">
                        La/s OF <field name="pending_feed_names" readonly="1" nolabel="1" class="o_inline"/>
                        se van a procesar con <strong>0 de alimento consumido</strong>.
                        Si ese día sí se consumió, cancelá y cargalo en la línea de
                        alimento de la solapa "Componentes" antes de procesar.
                    </p>
                </div>
                <field name="production_ids" invisible="1"/>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirmar y procesar" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
