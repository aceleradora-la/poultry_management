<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de la vista de producto para agregar el campo is_egg_production -->
    <record id="view_product_template_form_poultry" model="ir.ui.view">
        <field name="name">product.template.form.poultry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Agregar el campo después de "Can be Purchased" (Compras) -->
            <!-- Buscar el contenedor padre que tiene purchase_ok y agregar nuestro campo después de ese contenedor -->
            <xpath expr="//field[@name='purchase_ok']/parent::*" position="after">
                <div class="o_row">
                    <field name="is_egg_production" 
                           string="Usar en Producción de Huevos"
                           help="Marque este campo si este producto se utiliza en el proceso de producción de huevos."/>
                    <label for="is_egg_production"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

