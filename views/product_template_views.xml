<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extensión de la vista de producto para agregar el campo is_egg_production -->
    <record id="view_product_template_form_poultry" model="ir.ui.view">
        <field name="name">product.template.form.poultry</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Agregar el campo después de "Can be Purchased" (Compras) para evitar superposición -->
            <!-- Buscar purchase_ok dentro del sheet y agregar nuestro campo justo después -->
            <xpath expr="//sheet//field[@name='purchase_ok']" position="after">
                <field name="is_egg_production" 
                       string="Usar en Producción de Huevos"
                       help="Marque este campo si este producto se utiliza en el proceso de producción de huevos."
                       widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>

